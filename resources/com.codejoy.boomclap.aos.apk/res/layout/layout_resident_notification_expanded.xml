<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="170dp">
    <RelativeLayout
        android:id="@+id/residentClapButton"
        android:background="@drawable/bg_notify_button1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/boom_ic_notify_clap_big"
            android:adjustViewBounds="true"
            android:layout_centerInParent="true"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="5dp"
            android:text="Clap\10Mode"
            android:layout_marginHorizontal="5dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ff690097"
            android:ellipsize="end"
            android:gravity="center"
            android:background="@drawable/bg_notify_button_gradient"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginLeft="9dp"
            android:layout_marginRight="9dp"
            android:layout_marginBottom="9dp"
            android:text="Start"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="9dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/residentPrivacyButton"
        android:background="@drawable/bg_notify_button2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="6dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/boom_ic_notify_touch_big"
            android:adjustViewBounds="true"
            android:layout_centerInParent="true"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="5dp"
            android:text="Touch\10Mode"
            android:layout_marginHorizontal="5dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ff294389"
            android:ellipsize="end"
            android:gravity="center"
            android:background="@drawable/bg_notify_button_gradient"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginLeft="9dp"
            android:layout_marginRight="9dp"
            android:layout_marginBottom="9dp"
            android:text="Start"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="9dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/residentAntiTheftButton"
        android:background="@drawable/bg_notify_button3"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/boom_ic_notify_pocket_big"
            android:adjustViewBounds="true"
            android:layout_centerInParent="true"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="5dp"
            android:text="Pocket\10Mode"
            android:layout_marginHorizontal="5dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ff8f0000"
            android:ellipsize="end"
            android:gravity="center"
            android:background="@drawable/bg_notify_button_gradient"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginLeft="9dp"
            android:layout_marginRight="9dp"
            android:layout_marginBottom="9dp"
            android:text="Start"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="9dp"/>
    </RelativeLayout>
</LinearLayout>
