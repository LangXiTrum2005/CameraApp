<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/thinkup_myoffer_rl_root"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.thinkup.core.common.inner.ui.MuteImageView
        android:id="@+id/thinkup_myoffer_btn_mute_id"
        android:background="@drawable/thinkup_myoffer_video_mute_icon"
        android:layout_width="@dimen/thinkup_myoffer_half_screen_button_size"
        android:layout_height="@dimen/thinkup_myoffer_half_screen_button_size"
        android:layout_marginLeft="5dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <com.thinkup.core.common.inner.ui.PanelView
        android:id="@+id/thinkup_myoffer_banner_view_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/thinkup_myoffer_include_4_element"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/thinkup_myoffer_tv_reward_tip"
            android:background="@drawable/thinkup_myoffer_bg_feedback_button"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="10dp"
            android:text="@string/thinkup_click_to_get_reward"
            style="@style/thinkup_myoffer_single_line.nofontpadding"/>
        <com.thinkup.core.common.inner.ui.CountDownView
            android:id="@+id/thinkup_myoffer_count_down_view_id"
            android:layout_width="@dimen/thinkup_myoffer_half_screen_button_size"
            android:layout_height="@dimen/thinkup_myoffer_half_screen_button_size"
            android:layout_marginRight="12dp"/>
        <FrameLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.thinkup.core.common.inner.ui.CloseImageView
                android:layout_gravity="center"
                android:id="@+id/thinkup_myoffer_btn_close_id"
                android:background="@drawable/thinkup_myoffer_base_close_icon"
                android:layout_width="@dimen/thinkup_myoffer_half_screen_button_size"
                android:layout_height="@dimen/thinkup_myoffer_half_screen_button_size"/>
            <com.thinkup.core.common.inner.ui.CloseShadeView
                android:layout_gravity="center"
                android:id="@+id/thinkup_myoffer_btn_close_shade_id"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="@dimen/thinkup_myoffer_half_screen_button_size"
                android:layout_height="@dimen/thinkup_myoffer_half_screen_button_size"/>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/thinkup_myoffer_ad_lable"
        android:background="@drawable/thinkup_myoffer_splash_ad_label_bg"
        android:paddingLeft="5dp"
        android:paddingTop="2dp"
        android:paddingRight="5dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="2dp"
        android:text="@string/thinkup_basead_ad_text"
        android:layout_toRightOf="@+id/thinkup_myoffer_btn_mute_id"
        android:layout_alignParentTop="true"/>
</RelativeLayout>
