<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/topPopupLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/boomclap_bg_pop_top"
        app:layout_constraintDimensionRatio="375:227"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="#ff100b18"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topPopupLayout"/>
    <Space
        android:orientation="horizontal"
        android:id="@+id/spacer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/topPopupLayout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spacer">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/closeButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/boomclap_ic_pop_close"
            android:layout_marginEnd="26dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="26dp"
            android:textColor="#ffe3deff"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_time"
            android:includeFontPadding="false"
            app:customFontWeight="semibold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/closeButton"/>
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="18dp"
            android:textColor="#ff9d96bb"
            android:id="@+id/tvTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start"
            app:customFontWeight="medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/llPick"
            android:layout_width="match_parent"
            android:layout_height="188dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="27dp"
            android:layout_marginRight="30dp"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTip">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/boomclap_bg_pop_time"
                app:layout_constraintBottom_toBottomOf="@+id/npHour"
                app:layout_constraintEnd_toEndOf="@+id/npHour"
                app:layout_constraintStart_toStartOf="@+id/npHour"
                app:layout_constraintTop_toTopOf="@+id/npHour"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/boomclap_bg_pop_time"
                app:layout_constraintBottom_toBottomOf="@+id/npMinute"
                app:layout_constraintEnd_toEndOf="@+id/npMinute"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/npMinute"
                app:layout_constraintTop_toTopOf="@+id/npMinute"
                app:layout_constraintVertical_bias="0"/>
            <com.codejoy.boom.clap.widget.NumberPickerView
                android:id="@+id/npHour"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="28dp"
                app:layout_constraintEnd_toStartOf="@+id/npMinute"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:npv_DividerColor="@android:color/transparent"
                app:npv_DividerMarginLeft="24dp"
                app:npv_DividerMarginRight="24dp"
                app:npv_ItemPaddingHorizontal="5dp"
                app:npv_MaxValue="23"
                app:npv_MinValue="0"
                app:npv_RespondChangeOnDetached="false"
                app:npv_ShownCount="2"
                app:npv_TextColorNormal="#ff9d96bb"
                app:npv_TextColorSelected="#ffe3deff"
                app:npv_TextSizeNormal="27dp"
                app:npv_TextSizeSelected="33dp"
                app:npv_WrapSelectorWheel="false"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="26dp"
                android:textStyle="bold"
                android:textColor="#ffe3deff"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:layout_width="27dp"
                android:layout_height="wrap_content"
                android:text=":"
                app:layout_constraintBottom_toBottomOf="@+id/npHour"
                app:layout_constraintEnd_toStartOf="@+id/npMinute"
                app:layout_constraintStart_toEndOf="@+id/npHour"
                app:layout_constraintTop_toTopOf="@+id/npHour"/>
            <com.codejoy.boom.clap.widget.NumberPickerView
                android:id="@+id/npMinute"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/npHour"
                app:layout_constraintTop_toTopOf="parent"
                app:npv_DividerColor="@android:color/transparent"
                app:npv_DividerMarginLeft="24dp"
                app:npv_DividerMarginRight="24dp"
                app:npv_ItemPaddingHorizontal="5dp"
                app:npv_MaxValue="59"
                app:npv_MinValue="0"
                app:npv_RespondChangeOnDetached="false"
                app:npv_ShownCount="2"
                app:npv_TextColorNormal="#ff9d96bb"
                app:npv_TextColorSelected="#ffe3deff"
                app:npv_TextSizeNormal="27dp"
                app:npv_TextSizeSelected="33dp"
                app:npv_WrapSelectorWheel="false"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="24dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/confirmButton"
            android:background="@drawable/bg_gradient_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="34dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="30dp"
            android:text="@string/ok"
            android:layout_marginHorizontal="30dp"
            app:customFontWeight="semibold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llPick"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
