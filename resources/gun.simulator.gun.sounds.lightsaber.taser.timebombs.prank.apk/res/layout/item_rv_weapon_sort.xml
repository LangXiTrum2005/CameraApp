<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/weapon_sort"
        android:background="@drawable/home_bg_yellow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,332:124"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/img_weapon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/home_machine_gun"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/weapon_sort"
            app:layout_constraintEnd_toEndOf="@+id/weapon_sort"
            app:layout_constraintStart_toStartOf="@+id/weapon_sort"
            app:layout_constraintTop_toTopOf="@+id/weapon_sort"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:id="@+id/tv_weapon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="15dp"
            android:text="@string/machine_gun"
            android:fontFamily="@font/meb"
            app:layout_constraintBottom_toBottomOf="@+id/weapon_sort"
            app:layout_constraintEnd_toEndOf="@+id/weapon_sort"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
