<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/immersionBarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <RelativeLayout
        android:id="@+id/lay_title_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/ivBack"
            android:padding="8dp"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_back_white"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:layout_gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/fredoka_one_regular"/>
    </RelativeLayout>
    <com.flyco.tablayout.SlidingTabLayout
        android:id="@+id/sTab"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        tl:tl_divider_color="@color/transparent"
        tl:tl_divider_padding="16dp"
        tl:tl_divider_width="2dp"
        tl:tl_indicator_color="@color/text_blue_end"
        tl:tl_indicator_height="1.5dp"
        tl:tl_indicator_width_equal_title="true"
        tl:tl_tab_padding="22dp"
        tl:tl_tab_space_equal="false"
        tl:tl_textAllCaps="true"
        tl:tl_textSelectColor="@color/text_blue_end"
        tl:tl_textUnselectColor="@color/text_blue_start"
        tl:tl_underline_color="#1a000000"
        tl:tl_underline_height="0dp"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"/>
</LinearLayout>
