<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/cameraOverlay"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_400sdp"
        android:elevation="5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/paddingTop"
            android:background="@color/on_surface"
            android:layout_width="match_parent"
            android:layout_height="20dp"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/wrapFunction"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topFunction">
        <View
            android:id="@+id/line1"
            android:background="@color/on_surface"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.33"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line2"
            android:background="@color/on_surface"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.33"/>
        <View
            android:id="@+id/line3"
            android:background="@color/on_surface"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.66"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line4"
            android:background="@color/on_surface"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.66"/>
        <org.wysaid.view.CameraRecordGLSurfaceView
            android:id="@+id/myGLSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/focus"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_focus"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.photolab.vintage.view.VerticalSlider
            android:id="@+id/intensive"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:layout_marginRight="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vs_thumb_color="@color/colorAccent"
            app:vs_thumb_radius="10dp"
            app:vs_track_bg_color="@color/on_surface"
            app:vs_track_bg_thickness="2dp"
            app:vs_track_fg_color="@color/colorAccent"
            app:vs_track_fg_thickness="2dp"/>
        <TextView
            android:textSize="80sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:id="@+id/countDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/topFunction"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:weightSum="6"
        android:elevation="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/flash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/flashIcon"
                android:padding="8dp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_flash_off"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:padding="8dp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_grid"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/timer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/clock"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_clock"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ratio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/dark_red"
                android:gravity="center"
                android:id="@+id/ratioValue"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="3:4"
                android:fontFamily="sans-serif-light"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:padding="8dp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_info"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        app:layout_constraintBottom_toTopOf="@+id/wrapFunction"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wrapFunction"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:elevation="100dp"
        app:layout_constraintBottom_toTopOf="@+id/fl_adplaceholder">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/functions"
            android:paddingTop="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="6"
            android:elevation="100dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:id="@+id/none"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/none_icon"
                        android:padding="1dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_none"
                        android:tint="@color/on_surface_variant"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/on_surface"
                        android:id="@+id/none_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/filter"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/filter_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_filter"
                        android:tint="@color/on_surface_variant"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/on_surface"
                        android:id="@+id/filter_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filter"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/dust"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/dust_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_dust"
                        android:tint="@color/on_surface_variant"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/on_surface"
                        android:id="@+id/dust_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dust"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/light"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/light_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_light"
                        android:tint="@color/on_surface_variant"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/on_surface"
                        android:id="@+id/light_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/mask"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/mask_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_mask"
                        android:tint="@color/on_surface_variant"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/on_surface"
                        android:id="@+id/mask_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mask"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/gradient"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/gradient_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_gradient"
                        android:tint="@color/on_surface_variant"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/on_surface"
                        android:id="@+id/gradient_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gradient"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/takePhoto"
            android:layout_width="89dp"
            android:layout_height="89dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="45dp"
            android:src="@drawable/ic_capture_2"
            android:contentDescription="@string/app_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/gallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_gallery"
            app:civ_border_color="@color/white"
            app:civ_border_width="2dp"
            app:civ_circle_background_color="#f3f4f6"
            app:layout_constraintBottom_toBottomOf="@+id/takePhoto"
            app:layout_constraintEnd_toStartOf="@+id/takePhoto"
            app:layout_constraintHorizontal_bias="0.2"
            app:layout_constraintRight_toLeftOf="@+id/takePhoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/takePhoto"/>
        <RelativeLayout
            android:id="@+id/swap"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/takePhoto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/takePhoto">
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_swap"
                android:layout_centerInParent="true"
                app:civ_border_color="#f3f4f6"
                app:civ_border_width="2dp"
                app:civ_circle_background_color="#f3f4f6"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/fl_adplaceholder"
        android:background="@color/surface"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
