<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="174dp"
    app:cardBackgroundColor="@color/bg_item"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:src="@drawable/ic_placeholder"
        android:layout_marginHorizontal="24dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/ivDownload"
        android:background="@drawable/drw_circle_theme_blue_round"
        android:padding="6dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="20dp"
        android:src="@drawable/ic_download_black"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/ivGou"
        android:background="@drawable/drw_circle_theme_blue_round"
        android:padding="6dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="20dp"
        android:src="@drawable/ic_gou"/>
</androidx.cardview.widget.CardView>
