<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wrapAdjust"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/primary_container"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="64dp"
        android:layout_height="64dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check"
            android:tint="@color/on_surface_light"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/on_surface_light"
            android:layout_gravity="center"
            android:id="@+id/tool_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Text"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
