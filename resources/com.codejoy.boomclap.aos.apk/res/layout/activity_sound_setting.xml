<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHead"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,750:118"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/boomclap_bg_page_top_3"/>
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="20dp"
            android:textColor="@color/color_B0A5F4"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/sound"
            app:customFontWeight="semibold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4"
            app:layout_constraintWidth_percent="0.4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/boomclap_bg_home_middle_on"
        app:layout_constraintDimensionRatio="h,750:584"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.codejoy.boom.clap.widget.BoomNestedScrollView
        android:id="@+id/nestedScrollView"
        android:paddingBottom="30dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        app:layout_constraintBottom_toTopOf="@+id/templateView"
        app:layout_constraintTop_toBottomOf="@+id/clHead">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSoundCover"
                android:padding="8dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/playButton"
                android:background="@drawable/bg_sound_play_button_gradient"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivSoundCover">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPlay"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/bg_sound_play_button1"
                    app:tint="@color/white"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="16dp"
                    android:textColor="@color/white"
                    android:id="@+id/tvSoundName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    app:customFontWeight="semibold"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/playButton">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivMenuHead"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:src="@drawable/boomclap_bg_home_menu_top"
                    app:layout_constraintDimensionRatio="h,750:142"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="#0c0813"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivMenuHead"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clSoundView"
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:layout_marginLeft="17dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginRight="17dp"
                    android:layout_marginHorizontal="17dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/rvSoundList"
                        android:fadingEdge="horizontal"
                        android:fadingEdgeLength="5dp"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:requiresFadingEdge="horizontal"
                        android:layout_marginEnd="5dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/flMore"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <FrameLayout
                        android:id="@+id/flMore"
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="w,1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_home_sound_item"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="23dp"
                                android:layout_height="17dp"
                                android:src="@drawable/boomclap_ic_home_more_sound"/>
                            <com.codejoy.boom.clap.widget.ParkinsansFontText
                                android:textSize="16dp"
                                android:textColor="#e3deff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-4dp"
                                android:text="@string/more"
                                app:customFontWeight="medium"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <FrameLayout
                    android:id="@+id/flVolumeBar"
                    android:background="@drawable/boomclap_bg_settings_sound_small"
                    android:paddingTop="21dp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="-21dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintDimensionRatio="h,677:174"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llVolumeHead">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:layout_marginLeft="35dp"
                        android:layout_marginRight="35dp"
                        android:layout_marginHorizontal="35dp">
                        <View
                            android:id="@+id/bgVolumeBar"
                            android:background="@drawable/bg_volume_bar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                        <com.codejoy.boom.clap.widget.VolumeBar
                            android:id="@+id/volumeBar"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_margin="3dp"
                            app:layout_constraintBottom_toBottomOf="@+id/bgVolumeBar"
                            app:layout_constraintEnd_toEndOf="@+id/bgVolumeBar"
                            app:layout_constraintStart_toStartOf="@+id/bgVolumeBar"
                            app:layout_constraintTop_toTopOf="@+id/bgVolumeBar"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivVolumeArrow"
                            android:layout_width="30dp"
                            android:layout_height="16dp"
                            android:src="@drawable/boomclap_ic_sound_volume_narrow"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llVolumeHead"
                    android:background="@drawable/boomclap_bg_settings_menu"
                    android:paddingLeft="23dp"
                    android:paddingRight="23dp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginHorizontal="12dp"
                    android:paddingHorizontal="23dp"
                    app:layout_constraintDimensionRatio="h,339:51"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/clSoundView">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/boom_ic_volume"/>
                    <com.codejoy.boom.clap.widget.ParkinsansFontText
                        android:textSize="18dp"
                        android:textColor="#e3deff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume"
                        android:layout_marginStart="8dp"
                        app:customFontWeight="medium"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/flDurationBar"
                    android:background="@drawable/boomclap_bg_settings_sound_small"
                    android:paddingTop="21dp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="-21dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintDimensionRatio="h,339:104"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llDurationHead">
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/rvDuration"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginLeft="22dp"
                        android:layout_marginRight="22dp"
                        android:layout_marginHorizontal="22dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="4"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llDurationHead"
                    android:background="@drawable/boomclap_bg_settings_menu"
                    android:paddingLeft="23dp"
                    android:paddingRight="23dp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginHorizontal="12dp"
                    android:paddingHorizontal="23dp"
                    app:layout_constraintDimensionRatio="h,339:51"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/flVolumeBar">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/boom_ic_duration"/>
                    <com.codejoy.boom.clap.widget.ParkinsansFontText
                        android:textSize="18dp"
                        android:textColor="#e3deff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration"
                        android:layout_marginStart="8dp"
                        app:customFontWeight="medium"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llFlashMode"
                    android:background="@drawable/boomclap_bg_settings_menu"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="12dp"
                    android:paddingStart="23dp"
                    android:paddingEnd="28dp"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintDimensionRatio="h,339:55"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/flDurationBar">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/boomclap_ic_home_flash"/>
                    <com.codejoy.boom.clap.widget.ParkinsansFontText
                        android:textSize="18dp"
                        android:textColor="#e3deff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flash_mode"
                        android:layout_marginStart="8dp"
                        app:customFontWeight="medium"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <com.codejoy.boom.clap.widget.Switch
                        android:id="@+id/flashMode"
                        android:layout_width="55dp"
                        android:layout_height="28dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llVibratorMode"
                    android:background="@drawable/boomclap_bg_settings_menu"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="12dp"
                    android:paddingStart="23dp"
                    android:paddingEnd="28dp"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintDimensionRatio="h,339:55"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llFlashMode">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/boomclap_ic_home_vibration"/>
                    <com.codejoy.boom.clap.widget.ParkinsansFontText
                        android:textSize="18dp"
                        android:textColor="#e3deff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vibrator_mode"
                        android:layout_marginStart="8dp"
                        app:customFontWeight="medium"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <com.codejoy.boom.clap.widget.Switch
                        android:id="@+id/vibrationMode"
                        android:layout_width="55dp"
                        android:layout_height="28dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/moreSettingButton"
                    android:background="@drawable/boomclap_bg_settings_menu"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="30dp"
                    android:paddingStart="23dp"
                    android:paddingEnd="28dp"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="h,339:55"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llVibratorMode">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/boomclap_ic_home_more_settings"/>
                    <com.codejoy.boom.clap.widget.ParkinsansFontText
                        android:textSize="18dp"
                        android:textColor="#e3deff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/more_setting"
                        android:layout_marginStart="8dp"
                        app:customFontWeight="medium"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.codejoy.boom.clap.widget.BoomNestedScrollView>
    <View
        android:background="@drawable/bg_sound_setting_shadow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/nestedScrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-40dp"
        android:layout_marginStart="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clHead">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/boomclap_ic_sound_back"/>
    </LinearLayout>
    <View
        android:id="@+id/saveGuideLine"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.73"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="18dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/saveButton"
        android:background="@drawable/boom_but_save"
        android:layout_width="78dp"
        android:layout_height="0dp"
        android:layout_marginTop="-40dp"
        android:text="@string/save_button"
        android:maxLines="1"
        app:customFontWeight="medium"
        app:layout_constraintDimensionRatio="h,78:36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/saveGuideLine"
        app:layout_constraintTop_toBottomOf="@+id/clHead"/>
    <com.codejoy.boom.clap.ad.native_templates.TemplateView
        android:id="@+id/templateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:gnt_template_type="@layout/native_template3_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
