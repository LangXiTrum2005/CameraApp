<?xml version="1.0" encoding="utf-8"?>
<com.photolab.vintage.util.picker.widget.SquareItemLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/dark_grey_more"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_photo"
        android:background="@drawable/__picker_photo_bg"
        android:padding="1dp"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <ImageView
        android:id="@+id/v_selected"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="20dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</com.photolab.vintage.util.picker.widget.SquareItemLayout>
