<?xml version="1.0" encoding="utf-8"?>
<com.smartdigimkt.expressad.video.dynview.widget.AnyThinkFramLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sdm_ee_grey"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/sdm_native_ec_layout"
        android:background="@drawable/sdm_reward_end_card_shape_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="15dp">
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/sdm_tv_apptitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:scaleType="centerCrop"
            android:maxLines="1"
            android:layout_centerHorizontal="true"/>
        <com.smartdigimkt.expressad.video.dynview.widget.AnyThinkLevelLayoutView
            android:gravity="center_horizontal"
            android:id="@+id/sdm_sv_starlevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/sdm_tv_apptitle"/>
        <com.smartdigimkt.expressad.videocommon.view.RoundImageView
            android:id="@+id/sdm_iv_adbanner"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="-35dp"
            android:layout_marginRight="1dp"
            android:layout_below="@+id/sdm_iv_icon"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/sdm_iv_icon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerCrop"
            android:layout_below="@+id/sdm_sv_starlevel"
            android:layout_centerHorizontal="true"
            android:radius="10dp"/>
        <TextView
            android:textSize="11dp"
            android:gravity="center"
            android:id="@+id/sdm_tv_flag"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AD"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
        <com.smartdigimkt.expressad.video.dynview.widget.AnyThinkDyImageView
            android:id="@+id/sdm_iv_flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:gravity="center"
            android:id="@+id/sdm_tv_appdesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:layout_below="@+id/sdm_iv_adbanner"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sdm_tv_cta"
            android:layout_width="270dp"
            android:layout_height="50dp"
            android:lines="1"
            android:layout_below="@+id/sdm_tv_appdesc"
            android:layout_centerHorizontal="true"/>
        <com.smartdigimkt.expressad.video.dynview.widget.AnyThinkDyImageView
            android:id="@+id/sdm_iv_logo"
            android:layout_width="50dp"
            android:layout_height="18dp"
            android:layout_margin="10dp"
            android:src="@drawable/sdm_reward_end_pager_logo"
            android:layout_below="@+id/sdm_tv_cta"
            android:layout_centerHorizontal="true"/>
        <com.smartdigimkt.expressad.video.dynview.widget.AnythinkBaitClickView
            android:id="@+id/sdm_animation_click_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.smartdigimkt.expressad.video.dynview.widget.AnyThinkDyImageView
            android:id="@+id/sdm_iv_link"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/sdm_reward_notice"/>
        <com.smartdigimkt.expressad.widget.FeedBackButton
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/sdm_native_endcard_feed_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:text="@string/sdm_cm_feedback_btn_text"
            android:layout_toRightOf="@+id/sdm_iv_link"
            android:layout_alignTop="@+id/sdm_iv_link"/>
        <com.smartdigimkt.expressad.video.dynview.widget.AnyThinkDyImageView
            android:id="@+id/sdm_iv_close"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/sdm_reward_close"
            android:layout_alignParentRight="true"
            android:contentDescription="closeButton"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/sdm_native_ec_layer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.smartdigimkt.expressad.video.dynview.widget.AnyThinkFramLayout>
