<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/unActivatedLayout"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/activateButton"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_marginTop="125dp"
            android:src="@drawable/boomclap_btn_home_off"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.codejoy.boom.clap.widget.GradientTextView2
            android:textSize="26dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tvUnactivatedTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-7dp"
            android:text="@string/tap_to_activate"
            android:includeFontPadding="false"
            android:shadowColor="#33646464"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            app:customFontWeight="semibold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/activateButton"
            app:lineHeight="21dp"
            app:text_color_array="#ffffff,#DFA5F4"
            app:text_gradient_orientation="TOP_BOTTOM"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivGuideImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="110dp"
            android:src="@drawable/boomclap_ic_home_hand"
            android:layout_marginStart="-45dp"
            app:layout_constraintStart_toEndOf="@+id/activateButton"
            app:layout_constraintTop_toTopOf="@+id/activateButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activatedLayout"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <View
            android:id="@+id/lottie"
            android:background="@drawable/boomclap_scaning"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/disableButton"
            app:layout_constraintDimensionRatio="h,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/disableButton"
            app:layout_constraintWidth_percent="0.9"/>
        <View
            android:id="@+id/disableButton"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_marginTop="125dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.codejoy.boom.clap.widget.GradientTextView2
            android:textSize="21dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tvActivatedTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-7dp"
            android:text="@string/clap_whistle"
            android:includeFontPadding="false"
            android:shadowColor="#33646464"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            app:customFontWeight="semibold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/disableButton"
            app:lineHeight="21dp"
            app:text_color_array="#ffffff,#DFA5F4"
            app:text_gradient_orientation="TOP_BOTTOM"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
