<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sdm_myoffer_splash_ad_bottom_container"
    android:background="@drawable/sdm_myoffer_splash_bg_info"
    android:paddingTop="42dp"
    android:layout_width="match_parent"
    android:layout_height="120dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_toLeftOf="@+id/sdm_myoffer_panel_cta_layout">
        <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
            android:id="@+id/sdm_myoffer_iv_banner_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginRight="12dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="17dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/sdm_myoffer_tv_banner_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:lineSpacingMultiplier="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/sdm_myoffer_tv_banner_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:lineSpacingMultiplier="1"/>
        </LinearLayout>
    </LinearLayout>
    <com.smartdigimkt.sdk.basead.ui.component.CTAButtonLayout
        android:id="@+id/sdm_myoffer_panel_cta_layout"
        android:layout_width="@dimen/sdm_myoffer_landscape_banner_cta_max_width"
        android:layout_height="48dp"
        android:layout_marginRight="24dp"
        android:layout_alignParentRight="true"
        style="@style/sdm_myoffer_single_line"/>
    <include
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginRight="20dp"
        android:layout_toLeftOf="@+id/sdm_myoffer_panel_cta_layout"
        layout="@layout/sdm_myoffer_include_invalid_button"/>
</RelativeLayout>
