<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/effect_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,145:90"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.basic.lib.basic.view.RadiusImageView
            android:id="@+id/iv_effect"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/effect_background"
            app:layout_constraintEnd_toEndOf="@+id/effect_background"
            app:layout_constraintStart_toStartOf="@+id/effect_background"
            app:layout_constraintTop_toTopOf="@+id/effect_background"
            app:radius="4dp"/>
        <ImageView
            android:id="@+id/iv_stroke"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/stroke_shape"
            app:layout_constraintBottom_toBottomOf="@+id/effect_background"
            app:layout_constraintEnd_toEndOf="@+id/effect_background"
            app:layout_constraintStart_toStartOf="@+id/effect_background"
            app:layout_constraintTop_toTopOf="@+id/effect_background"/>
        <ImageView
            android:id="@+id/iv_border"
            android:background="@drawable/icon_border_scene_is_choose"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/effect_background"
            app:layout_constraintEnd_toEndOf="@+id/effect_background"
            app:layout_constraintStart_toStartOf="@+id/effect_background"
            app:layout_constraintTop_toTopOf="@+id/effect_background"/>
        <ImageView
            android:id="@+id/iv_tick"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/icon_scene_is_choose"
            app:layout_constraintHeight_percent="0.2222"
            app:layout_constraintStart_toStartOf="@+id/effect_background"
            app:layout_constraintTop_toTopOf="@+id/effect_background"
            app:layout_constraintWidth_percent="0.1379"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_selected"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="iv_border , iv_tick"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
