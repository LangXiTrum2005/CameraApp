<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.codejoy.boom.clap.widget.BoomNestedScrollView
        android:id="@+id/scrollView"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="10dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toTopOf="@+id/templateView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.codejoy.boom.clap.widget.ClapButton
                android:id="@+id/homeClapView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/faqButton"
                android:background="@drawable/boom_ic_faq_bg"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="-10dp"
                android:layout_marginRight="18dp"
                android:paddingStart="16dp"
                android:paddingEnd="18dp"
                android:layout_marginHorizontal="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/homeClapView">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/boom_ic_help"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="17dp"
                    android:textColor="#e3deff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/how_to_use"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="6dp"
                    app:customFontWeight="medium"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="10dp"
                    android:layout_height="16dp"
                    android:src="@drawable/boom_ic_help_more"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/flRecycleView"
                android:background="@drawable/bg_gradient_home_sound_list"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/faqButton">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSoundList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="3"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.codejoy.boom.clap.widget.BoomNestedScrollView>
    <View
        android:id="@+id/shadowView"
        android:background="@drawable/bg_home_gradient_shadow"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/scrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.codejoy.boom.clap.ad.native_templates.TemplateView
        android:id="@+id/templateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:gnt_template_type="@layout/native_template4_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
