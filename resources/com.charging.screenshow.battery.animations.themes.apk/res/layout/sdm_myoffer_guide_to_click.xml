<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.smartdigimkt.sdk.basead.ui.WaveAnimImageView
        android:id="@+id/sdm_myoffer_wave_anim_image"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerInParent="true"/>
    <com.smartdigimkt.sdk.basead.ui.WaveAnimImageView
        android:id="@+id/sdm_myoffer_wave_anim_image2"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/sdm_myoffer_guide_to_click_finger"
        android:layout_width="100dp"
        android:layout_height="110dp"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="100dp"
        android:scaleType="fitXY"
        android:layout_alignLeft="@+id/sdm_myoffer_wave_anim_image"
        android:layout_alignTop="@+id/sdm_myoffer_wave_anim_image"/>
    <TextView
        android:textSize="18dp"
        android:textColor="#ffffff"
        android:id="@+id/sdm_myoffer_guide_to_click_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/sdm_myoffer_tap_for_detail"
        android:layout_below="@+id/sdm_myoffer_guide_to_click_finger"
        android:layout_centerHorizontal="true"/>
</merge>
