<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/thinkup_myoffer_banner_root"
    android:background="@drawable/thinkup_myoffer_bg_banner"
    android:layout_width="320dp"
    android:layout_height="90dp">
    <FrameLayout
        android:id="@+id/thinkup_myoffer_banner_icon_container"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_centerVertical="true">
        <com.thinkup.core.common.ui.component.RoundImageView
            android:id="@+id/thinkup_myoffer_banner_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <TextView
        android:textSize="6sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/thinkup_myoffer_ad_lable"
        android:background="@drawable/thinkup_myoffer_splash_ad_label_bg"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="1dp"
        android:text="@string/thinkup_basead_ad_text"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/thinkup_ll_title_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp"
        android:layout_toRightOf="@+id/thinkup_myoffer_banner_icon_container">
        <com.thinkup.core.common.ui.component.NoShadowMarqueeTextView
            android:textSize="14dp"
            android:textColor="#000000"
            android:ellipsize="marquee"
            android:gravity="left"
            android:id="@+id/thinkup_myoffer_banner_ad_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"/>
        <com.thinkup.core.common.ui.component.NoShadowMarqueeTextView
            android:textSize="12dp"
            android:textColor="#000000"
            android:ellipsize="marquee"
            android:gravity="left"
            android:id="@+id/thinkup_myoffer_banner_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"/>
    </LinearLayout>
    <com.thinkup.core.common.inner.ui.ScanningAnimButton
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/thinkup_myoffer_banner_ad_install_btn"
        android:background="@drawable/thinkup_myoffer_splash_bg_rectangle_btn_cta_asseblem"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_toRightOf="@+id/thinkup_myoffer_banner_icon_container"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        style="@style/thinkup_myoffer_single_line"/>
    <include layout="@layout/thinkup_myoffer_include_4_element_banner"/>
</RelativeLayout>
