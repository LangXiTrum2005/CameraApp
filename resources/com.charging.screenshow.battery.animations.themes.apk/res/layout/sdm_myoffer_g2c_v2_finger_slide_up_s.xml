<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@+id/sdm_myoffer_g2c_item_line"
        android:layout_width="18dp"
        android:layout_height="72dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/sdm_myoffer_g2c_white_line_2"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/sdm_myoffer_g2c_item_point"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="56dp"
        android:src="@drawable/sdm_myoffer_g2c_white_point"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/sdm_myoffer_g2c_item_finger"
        android:layout_width="30dp"
        android:layout_height="33dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="72dp"
        android:src="@drawable/sdm_myoffer_finger_white_v1"
        android:scaleType="fitCenter"
        android:layout_alignLeft="@+id/sdm_myoffer_g2c_item_point"/>
</merge>
