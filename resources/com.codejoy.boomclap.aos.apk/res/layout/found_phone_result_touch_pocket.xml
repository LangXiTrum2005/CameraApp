<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ff3c0303"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/topImage"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:src="@drawable/boomclap_bg_page_top_3_light"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="20dp"
        android:textColor="@color/white"
        android:id="@+id/tvLocated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/activate"
        app:customFontWeight="semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/logoBackground"
        android:layout_width="0dp"
        android:layout_height="197dp"
        android:src="@drawable/boomclap_bg_activate_light"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/ivLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivLogo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/boomclap_ic_located_light"
        app:layout_constraintDimensionRatio="220:180"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topImage"
        app:layout_constraintWidth_percent="0.6"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="24dp"
        android:textColor="#fff0ecc7"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="50dp"
        android:text="@string/your_phone_was_pocket"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="50dp"
        app:customFontWeight="semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="20dp"
        android:textColor="#fff0eeff"
        android:id="@+id/closeButton"
        android:paddingLeft="50dp"
        android:paddingTop="14dp"
        android:paddingRight="50dp"
        android:paddingBottom="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/close"
        android:paddingHorizontal="50dp"
        android:paddingVertical="14dp"
        app:customFontWeight="semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <com.codejoy.boom.clap.ad.native_templates.TemplateView
        android:id="@+id/templateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:gnt_template_type="@layout/native_template3_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
