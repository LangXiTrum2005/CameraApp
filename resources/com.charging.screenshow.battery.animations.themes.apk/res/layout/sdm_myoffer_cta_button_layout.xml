<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.smartdigimkt.sdk.basead.ui.ScanningAnimButton
        android:textSize="@dimen/sdm_myoffer_splash_cta_text_size"
        android:textColor="@color/sdm_color_cta_text"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sdm_myoffer_cta_button_minor"
        android:background="@drawable/sdm_myoffer_splash_bg_rectangle_btn_cta_asseblem_minor"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_marginRight="12dp"
        android:text="@string/sdm_myoffer_minor_cta_text"
        android:maxLines="1"
        style="@style/sdm_myoffer_single_line"/>
    <RelativeLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <com.smartdigimkt.sdk.basead.ui.ScanningAnimButton
            android:textSize="@dimen/sdm_myoffer_splash_cta_text_size"
            android:textColor="#d9ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_cta_button_major"
            android:background="@drawable/sdm_myoffer_splash_bg_rectangle_btn_cta_asseblem"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="立即下载"
            android:maxLines="1"
            style="@style/sdm_myoffer_single_line"/>
    </RelativeLayout>
</merge>
