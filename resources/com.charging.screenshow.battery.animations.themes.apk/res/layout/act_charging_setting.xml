<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/immersionBarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <RelativeLayout
        android:id="@+id/lay_title_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/ivBack"
            android:padding="8dp"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_back_white"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:layout_gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:layout_centerInParent="true"
            android:fontFamily="@font/fredoka_one_regular"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llSounds"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title_item"
            android:gravity="start"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/play_sound_with_animation"
            android:layout_weight="1"
            android:fontFamily="@string/Roboto_Medium"/>
        <androidx.appcompat.widget.SwitchCompat
            android:textColorHint="@color/switch_bg"
            android:id="@+id/switchSounds"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llDuration"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title_item"
            android:gravity="start"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/play_duration"
            android:layout_weight="1"
            android:fontFamily="@string/Roboto_Medium"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_content_item"
            android:gravity="start"
            android:id="@+id/tvDuration"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@string/Roboto_Medium"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_right"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llClose"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title_item"
            android:gravity="start"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/close_method"
            android:layout_weight="1"
            android:fontFamily="@string/Roboto_Medium"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_content_item"
            android:gravity="start"
            android:id="@+id/tvCloseType"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@string/Roboto_Medium"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_right"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llScreen"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="start"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/show_only_on_lock_screen"
            android:layout_weight="1"
            android:fontFamily="@string/Roboto_Medium"/>
        <androidx.appcompat.widget.SwitchCompat
            android:textColorHint="@color/switch_bg"
            android:id="@+id/switchScreen"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llBatteryText"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title_item"
            android:gravity="start"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/show_battery_percentage"
            android:layout_weight="1"
            android:fontFamily="@string/Roboto_Medium"/>
        <androidx.appcompat.widget.SwitchCompat
            android:textColorHint="@color/switch_bg"
            android:id="@+id/switchBatteryText"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</LinearLayout>
