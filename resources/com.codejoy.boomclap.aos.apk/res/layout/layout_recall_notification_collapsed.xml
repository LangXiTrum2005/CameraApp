<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_recall_notification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp">
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@mipmap/logo"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"
        android:layout_marginStart="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0c0d0b"
            android:ellipsize="end"
            android:id="@+id/tvRecallNotifyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bringback_title"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#cc000000"
            android:ellipsize="end"
            android:id="@+id/tvRecallNotifyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/bringback_body"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
