<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sdm_myoffer_letter_top"
    android:layout_width="match_parent"
    android:layout_height="111dp">
    <com.smartdigimkt.sdk.basead.ui.component.CTAButtonLayout
        android:id="@+id/sdm_myoffer_panel_cta_layout"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentBottom="true"
        style="@style/sdm_myoffer_single_line"/>
    <ImageView
        android:id="@+id/sdm_myoffer_letter_icon"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/sdm_myoffer_single_line"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_4_element"/>
</RelativeLayout>
