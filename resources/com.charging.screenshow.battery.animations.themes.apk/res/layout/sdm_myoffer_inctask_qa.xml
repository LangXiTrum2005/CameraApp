<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sdm_myoffer_inctask_close_view"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="110dp"
        android:layout_marginRight="24dp"
        android:src="@drawable/sdm_myoffer_icon_close_with_border"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/sdm_myoffer_inctask_close_view"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="28dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_inctask_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_inctask_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="20dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_inctask_answer_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="84dp"
            android:text="@string/sdm_myoffer_g2c_question_dialog_title"/>
        <TextView
            android:textSize="20dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_inctask_answer_right"
            android:background="@drawable/sdm_myoffer_bg_button_radius_12"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="248dp"
            android:layout_height="64dp"
            android:layout_marginTop="34dp"
            android:text="@string/sdm_myoffer_g2c_question_dialog_default_answer"
            android:maxLines="1"
            android:backgroundTint="#ffffbe16"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
        <TextView
            android:textSize="20dp"
            android:textColor="#b56200"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_inctask_answer_wrong"
            android:background="@drawable/sdm_myoffer_bg_button_radius_12"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="248dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="@string/sdm_myoffer_inctask_qa_default_wrong"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
        <ImageView
            android:id="@+id/sdm_myoffer_inctask_right_hint"
            android:visibility="gone"
            android:layout_width="360dp"
            android:layout_height="114dp"
            android:layout_marginTop="100dp"/>
    </LinearLayout>
</RelativeLayout>
