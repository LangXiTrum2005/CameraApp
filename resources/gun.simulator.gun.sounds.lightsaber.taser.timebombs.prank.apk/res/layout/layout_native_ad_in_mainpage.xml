<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nativeAdView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,360:120"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/iv_ad_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="w,180:120"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0632"/>
        <ImageView
            android:id="@+id/iv_ad_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/iv_label_ad"
            app:layout_constraintStart_toStartOf="@+id/iv_ad_title"
            app:layout_constraintTop_toTopOf="@+id/iv_ad_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#fff"
            android:ellipsize="end"
            android:id="@+id/tv_native_ad_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/PrankGuys"
            android:maxLines="2"
            android:lineSpacingExtra="2sp"
            android:fontFamily="@font/rb"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:letterSpacing="0.01"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_ad_title"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/tv_native_ad_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/Funny_all_in"
            android:maxLines="2"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_native_ad_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_native_ad_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/bt_download"
            android:background="@drawable/bg_bt_ad_download"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="5dp"
            android:text="@string/Download"
            android:fontFamily="@font/rb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="h,157:33"
            app:layout_constraintEnd_toEndOf="@+id/tv_native_ad_content"
            app:layout_constraintStart_toStartOf="@+id/tv_native_ad_content"
            app:layout_constraintTop_toBottomOf="@+id/tv_native_ad_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
