<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_guide_language_selector"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCountryFlag"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="15dp"
            android:textColor="#9d96bb"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:customFontWeight="medium"/>
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="15dp"
            android:textColor="#e3deff"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvSelLanguage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:shadowColor="#40646464"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="9"
            app:customFontWeight="bold"/>
    </FrameLayout>
</LinearLayout>
