<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/sdm_myoffer_banner_root"
    android:background="@drawable/sdm_myoffer_bg_banner"
    android:layout_width="320dp"
    android:layout_height="50dp">
    <FrameLayout
        android:id="@+id/sdm_myoffer_main_resouce_container"
        android:background="@drawable/sdm_myoffer_bg_banner_native"
        android:clipChildren="true"
        android:layout_width="102dp"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <FrameLayout
        android:id="@+id/sdm_myoffer_banner_icon_container"
        android:clipChildren="true"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="7dp"
        android:layout_toRightOf="@+id/sdm_myoffer_main_resouce_container"
        android:layout_centerVertical="true">
        <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
            android:id="@+id/sdm_myoffer_banner_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <com.smartdigimkt.sdk.basead.ui.CloseImageView
        android:id="@+id/sdm_myoffer_banner_close"
        android:background="#a0a0a0"
        android:padding="1dp"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/sdm_browser_close_icon"
        android:tint="#ffffff"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <FrameLayout
        android:id="@+id/sdm_myoffer_ad_logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="1dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
            android:layout_gravity="center"
            android:id="@+id/sdm_myoffer_ad_logo"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"/>
    </FrameLayout>
    <TextView
        android:textSize="6sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/sdm_myoffer_ad_local_logo"
        android:background="@drawable/sdm_myoffer_splash_ad_label_bg"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:text="@string/sdm_basead_ad_text"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sdm_ll_title_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:layout_marginRight="7dp"
        android:layout_toLeftOf="@+id/sdm_myoffer_banner_ad_install_btn"
        android:layout_toRightOf="@+id/sdm_myoffer_banner_icon_container"
        android:layout_centerVertical="true">
        <com.smartdigimkt.sdk.basead.ui.component.NoShadowMarqueeTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:ellipsize="marquee"
            android:gravity="left"
            android:id="@+id/sdm_myoffer_banner_ad_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"/>
        <com.smartdigimkt.sdk.basead.ui.component.NoShadowMarqueeTextView
            android:textSize="12dp"
            android:textColor="#000000"
            android:ellipsize="marquee"
            android:gravity="left"
            android:id="@+id/sdm_myoffer_banner_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/sdm_myoffer_four_element_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="25dp"
        android:layout_toLeftOf="@+id/sdm_myoffer_ad_logo_container"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="6dp"
                android:textColor="#a0a0a0"
                android:id="@+id/sdm_myoffer_version_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="3dp"
                android:layout_toLeftOf="@+id/sdm_myoffer_privacy_agreement"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="6dp"
                android:textColor="#a0a0a0"
                android:id="@+id/sdm_myoffer_privacy_agreement"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sdm_myoffer_panel_privacy"
                android:layout_toLeftOf="@+id/sdm_myoffer_banner_center_line"
                android:layout_alignParentBottom="true"/>
            <View
                android:id="@+id/sdm_myoffer_banner_center_line"
                android:background="#a0a0a0"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="7dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_toLeftOf="@+id/sdm_myoffer_permission_manage"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="6dp"
                android:textColor="#a0a0a0"
                android:ellipsize="marquee"
                android:id="@+id/sdm_myoffer_permission_manage"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sdm_myoffer_panel_permission"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
            <View
                android:id="@+id/sdm_myoffer_banner_center_line2"
                android:background="#a0a0a0"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="7dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_toLeftOf="@+id/sdm_myoffer_permission_manage"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="6dp"
                android:textColor="#a0a0a0"
                android:ellipsize="marquee"
                android:id="@+id/sdm_myoffer_function_manage"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sdm_myoffer_panel_funtion"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textSize="6dp"
        android:textColor="#a0a0a0"
        android:id="@+id/sdm_myoffer_publisher_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginRight="3dp"
        android:layout_toLeftOf="@+id/sdm_myoffer_banner_close"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="6sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/sdm_myoffer_banner_ad_from"
        android:background="#888888"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_toRightOf="@+id/sdm_myoffer_ad_local_logo"
        android:layout_alignTop="@+id/sdm_myoffer_ad_local_logo"
        android:layout_alignBottom="@+id/sdm_myoffer_ad_local_logo"/>
    <com.smartdigimkt.sdk.basead.ui.ScanningAnimButton
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/sdm_myoffer_banner_ad_install_btn"
        android:background="@drawable/sdm_myoffer_bg_btn_cta_banner_radius_24"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:maxWidth="70dp"
        android:minWidth="60dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        style="@style/sdm_myoffer_single_line"/>
</RelativeLayout>
