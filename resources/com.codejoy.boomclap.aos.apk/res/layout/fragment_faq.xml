<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.codejoy.boom.clap.widget.BoomNestedScrollView
        android:id="@+id/nestedScrollView"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toTopOf="@+id/templateView"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/faqNumber1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/boomclap_ic_how_to_use_1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="15dp"
                    android:textColor="#e3deff"
                    android:id="@+id/tvFaqTip1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq_tip1"
                    android:layout_marginStart="13dp"
                    app:layout_constraintBottom_toBottomOf="@+id/faqNumber1"
                    app:layout_constraintStart_toEndOf="@+id/faqNumber1"
                    app:layout_constraintTop_toTopOf="@+id/faqNumber1"
                    app:lineHeight="20dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivFaq1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="30dp"
                    android:src="@drawable/alert_img_clap_1"
                    android:layout_marginHorizontal="30dp"
                    app:layout_constraintDimensionRatio="275:150"
                    app:layout_constraintTop_toBottomOf="@+id/tvFaqTip1"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/faqNumber2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/boomclap_ic_how_to_use_2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="15dp"
                    android:textColor="#e3deff"
                    android:id="@+id/tvFaqTip2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq_tip2"
                    android:layout_marginStart="13dp"
                    app:layout_constraintBottom_toBottomOf="@+id/faqNumber2"
                    app:layout_constraintStart_toEndOf="@+id/faqNumber2"
                    app:layout_constraintTop_toTopOf="@+id/faqNumber2"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivFaq2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="30dp"
                    android:src="@drawable/alert_img_clap_2"
                    android:layout_marginHorizontal="30dp"
                    app:layout_constraintDimensionRatio="275:150"
                    app:layout_constraintTop_toBottomOf="@+id/tvFaqTip2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/faqNumber3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/boomclap_ic_how_to_use_3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="15dp"
                    android:textColor="#e3deff"
                    android:id="@+id/tvFaqTip3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq_tip3"
                    android:layout_marginStart="13dp"
                    app:layout_constraintBottom_toBottomOf="@+id/faqNumber3"
                    app:layout_constraintStart_toEndOf="@+id/faqNumber3"
                    app:layout_constraintTop_toTopOf="@+id/faqNumber3"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivFaq3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="30dp"
                    android:src="@drawable/alert_img_clap_3"
                    android:layout_marginHorizontal="30dp"
                    app:layout_constraintDimensionRatio="275:150"
                    app:layout_constraintTop_toBottomOf="@+id/tvFaqTip3"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="15dp"
                android:layout_marginHorizontal="20dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/faqNumber4"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/boomclap_ic_how_to_use_4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="15dp"
                    android:textColor="#e3deff"
                    android:id="@+id/tvFaqTip4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq_tip4"
                    android:layout_marginStart="13dp"
                    app:layout_constraintBottom_toBottomOf="@+id/faqNumber4"
                    app:layout_constraintStart_toEndOf="@+id/faqNumber4"
                    app:layout_constraintTop_toTopOf="@+id/faqNumber4"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivFaq4"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="30dp"
                    android:src="@drawable/alert_img_clap_4"
                    android:layout_marginHorizontal="30dp"
                    app:layout_constraintDimensionRatio="275:150"
                    app:layout_constraintTop_toBottomOf="@+id/tvFaqTip4"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.codejoy.boom.clap.widget.BoomNestedScrollView>
    <View
        android:id="@+id/shadowView"
        android:background="@drawable/bg_faq_gradient_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="@+id/nestedScrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivGuideImage"
        android:visibility="gone"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:src="@drawable/boomclap_ic_home_hand"
        android:layout_marginEnd="23dp"
        app:layout_constraintBottom_toBottomOf="@+id/nestedScrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/nestedScrollView"/>
    <com.codejoy.boom.clap.ad.native_templates.TemplateView
        android:id="@+id/templateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:gnt_template_type="@layout/native_template3_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
