<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/thinkup_myoffer_splash_ad_bottom_container"
    android:background="@drawable/thinkup_myoffer_splash_bg_info"
    android:paddingTop="64dp"
    android:layout_width="match_parent"
    android:layout_height="240dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/thinkup_myoffer_ll_top_content"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp">
        <com.thinkup.core.common.ui.component.RoundImageView
            android:id="@+id/thinkup_myoffer_iv_banner_icon"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginRight="18dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/thinkup_myoffer_tv_banner_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:lineSpacingMultiplier="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/thinkup_myoffer_tv_banner_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:maxLines="2"
                android:lineSpacingMultiplier="1"/>
        </LinearLayout>
    </LinearLayout>
    <com.thinkup.core.common.inner.ui.ScanningAnimButton
        android:id="@+id/thinkup_myoffer_panel_cta_layout"
        android:background="@drawable/thinkup_myoffer_splash_bg_rectangle_btn_cta_asseblem"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="78dp"
        android:layout_marginRight="24dp"/>
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="44dp"
        android:layout_alignParentBottom="true"
        layout="@layout/thinkup_myoffer_include_invalid_button"/>
</RelativeLayout>
