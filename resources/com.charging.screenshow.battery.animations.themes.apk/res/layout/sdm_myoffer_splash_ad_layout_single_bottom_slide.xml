<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
        android:id="@+id/sdm_myoffer_splash_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.smartdigimkt.sdk.basead.ui.WrapRoundImageView
        android:id="@+id/sdm_myoffer_splash_ad_content_image_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <com.smartdigimkt.sdk.basead.ui.PlayerView
        android:id="@+id/sdm_myoffer_player_view_id"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.smartdigimkt.sdk.basead.ui.MuteImageView
        android:id="@+id/sdm_myoffer_btn_mute_id"
        android:background="@drawable/sdm_myoffer_video_mute_icon"
        android:visibility="gone"
        android:layout_width="@dimen/sdm_myoffer_half_screen_button_size"
        android:layout_height="@dimen/sdm_myoffer_half_screen_button_size"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"/>
    <ImageView
        android:id="@+id/sdm_myoffer_player_view_cover_img_id"
        android:background="#fafafa"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/sdm_myoffer_player_view_cover_icon_id"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/sdm_player_view_placeholder_icon"
        android:layout_centerInParent="true"/>
    <include layout="@layout/sdm_myoffer_include_guide2click_mask"/>
    <ImageView
        android:id="@+id/sdm_myoffer_splash_ad_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/sdm_myoffer_bg_splash_bottom"
        android:scaleType="fitXY"
        android:layout_alignTop="@+id/sdm_myoffer_splash_ad_bottom_container"
        android:layout_alignBottom="@+id/sdm_myoffer_splash_ad_bottom_container"/>
    <com.smartdigimkt.sdk.basead.ui.component.SplashBottomContainer
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/sdm_myoffer_splash_ad_bottom_container"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/sdm_myoffer_splash_ad_bottom_slide_icon"
            android:layout_width="20dp"
            android:layout_height="26dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/sdm_myoffer_slide_up_arrow_1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:id="@+id/sdm_myoffer_splash_ad_bottom_slide_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sdm_myoffer_splash_bottom_hint"/>
        <com.smartdigimkt.sdk.basead.ui.SplashBottomShakeTextHintView
            android:id="@+id/sdm_myoffer_splash_cta_shake"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#ffffff"
            android:id="@+id/sdm_myoffer_splash_ad_bottom_slide_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:layout_marginBottom="20dp"
            android:text="@string/sdm_myoffer_splash_bottom_hint2"/>
        <include
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            layout="@layout/sdm_myoffer_include_invalid_button"/>
    </com.smartdigimkt.sdk.basead.ui.component.SplashBottomContainer>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_4_element"/>
    <include layout="@layout/sdm_myoffer_include_guide2click_container"/>
    <include layout="@layout/sdm_myoffer_include_splash_ad_layout_skip_area"/>
</merge>
