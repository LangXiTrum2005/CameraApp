<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/immersionBarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp">
                <View
                    android:id="@+id/top"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivBack"
                    android:padding="8dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_back_white"
                    android:layout_marginStart="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/top"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_specs_tittle"
                    android:maxLines="1"
                    android:fontFamily="@font/fredoka_one_regular"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivBack"
                    app:layout_constraintEnd_toStartOf="@+id/batteryCard"
                    app:layout_constraintStart_toEndOf="@+id/ivBack"
                    app:layout_constraintTop_toBottomOf="@+id/top"/>
                <View
                    android:layout_width="32dp"
                    android:layout_height="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/batteryCard"
                    app:layout_constraintEnd_toEndOf="@+id/batteryCard"
                    app:layout_constraintStart_toStartOf="@+id/batteryCard"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/batteryCard"
                    android:layout_width="100dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/heroSection"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/white"
                    app:strokeWidth="2dp">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <me.itangqi.waveloadingview.WaveLoadingView
                            android:id="@+id/waveLoadingView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:wlv_borderColor="@color/battery_border"
                            app:wlv_borderWidth="0dp"
                            app:wlv_progressValue="0"
                            app:wlv_round_rectangle="true"
                            app:wlv_shapeType="rectangle"
                            app:wlv_titleBottom=""
                            app:wlv_titleCenter=""
                            app:wlv_titleCenterColor="@android:color/white"
                            app:wlv_titleCenterSize="24sp"
                            app:wlv_titleCenterStrokeColor="@android:color/holo_blue_dark"
                            app:wlv_titleCenterStrokeWidth="3dp"
                            app:wlv_titleTop=""
                            app:wlv_triangle_direction="north"
                            app:wlv_waveAmplitude="30"
                            app:wlv_waveColor="@color/battery_wave"
                            app:wlv_wave_background_Color="@color/bg_item"/>
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka_one_regular"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/heroSection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toStartOf="@+id/batteryCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivBack">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/battery"
                        android:includeFontPadding="false"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="60sp"
                            android:textColor="@color/text_title_green"
                            android:id="@+id/tvPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/baloothambi2_semibold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@mipmap/ic_bolt"
                            android:contentDescription="@null"
                            android:layout_marginStart="4dp"
                            app:layout_constraintBottom_toBottomOf="@+id/tvPercent"
                            app:layout_constraintStart_toEndOf="@+id/tvPercent"
                            app:layout_constraintTop_toTopOf="@+id/tvPercent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <View
                            android:background="@mipmap/bg_dot_green"
                            android:layout_width="8dp"
                            android:layout_height="8dp"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/text_title_green"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/good_condition"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutHealth"
                    android:background="@drawable/bg_item_16dp"
                    android:padding="16dp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="@+id/layoutTemperature"
                    app:layout_constraintEnd_toStartOf="@+id/layoutTemperature"
                    app:layout_constraintHeight_min="100dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/heroSection">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@mipmap/ic_health"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_title_item"
                            android:ellipsize="end"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/health"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_content_item"
                        android:ellipsize="end"
                        android:id="@+id/tvHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_title_item"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/battery_health_is_normal"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutTemperature"
                    android:background="@drawable/bg_item_16dp"
                    android:padding="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_min="100dp"
                    app:layout_constraintStart_toEndOf="@+id/layoutHealth"
                    app:layout_constraintTop_toBottomOf="@+id/heroSection">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@mipmap/ic_temperature"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_title_item"
                            android:ellipsize="end"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/temperature"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_content_item"
                        android:ellipsize="end"
                        android:id="@+id/tvTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_title_item"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/temperature_normal"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutVoltage"
                    android:background="@drawable/bg_item_16dp"
                    android:padding="16dp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="@+id/layoutType"
                    app:layout_constraintEnd_toStartOf="@+id/layoutType"
                    app:layout_constraintHeight_min="100dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutHealth">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@mipmap/ic_voltage"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_title_item"
                            android:ellipsize="end"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/voltage"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_content_item"
                        android:ellipsize="end"
                        android:id="@+id/tvVoltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_title_item"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/voltage_normal"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutType"
                    android:background="@drawable/bg_item_16dp"
                    android:padding="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_min="100dp"
                    app:layout_constraintStart_toEndOf="@+id/layoutVoltage"
                    app:layout_constraintTop_toBottomOf="@+id/layoutTemperature">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@mipmap/ic_charge_type"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_title_item"
                            android:ellipsize="end"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/charge_type"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_content_item"
                        android:ellipsize="end"
                        android:id="@+id/tvType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_title_item"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/plugged_in"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutTime"
                    android:background="@drawable/bg_item_16dp"
                    android:padding="16dp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="@+id/layoutCapacity"
                    app:layout_constraintEnd_toStartOf="@+id/layoutCapacity"
                    app:layout_constraintHeight_min="100dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutVoltage">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@mipmap/ic_time_remaining"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_title_item"
                            android:ellipsize="end"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/time"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_content_item"
                        android:ellipsize="end"
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_title_item"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/estimated_time_good"
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutCapacity"
                    android:background="@drawable/bg_item_16dp"
                    android:padding="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_min="100dp"
                    app:layout_constraintStart_toEndOf="@+id/layoutTime"
                    app:layout_constraintTop_toBottomOf="@+id/layoutType">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@mipmap/ic_capacity"
                            android:contentDescription="@null"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_title_item"
                            android:ellipsize="end"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/capacity"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_content_item"
                        android:ellipsize="end"
                        android:id="@+id/tvCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_title_item"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/design_capacity"
                        android:maxLines="1"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutBatteryStatus"
                    android:background="@drawable/bg_item_16dp"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutTime">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_title_green"
                        android:ellipsize="end"
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_status"
                        android:maxLines="1"
                        app:layout_constraintEnd_toStartOf="@+id/layoutStatusBadge"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/layoutStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/progressBattery"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="50dp"
                            android:layout_marginBottom="4dp"
                            android:src="@mipmap/ic_good"/>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/progressBattery"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="79"
                        android:progressDrawable="@drawable/bg_battery_progress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvStatusTitle"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_title_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0%"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/progressBattery"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_title_item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="100%"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/progressBattery"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutBatteryStatus"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
