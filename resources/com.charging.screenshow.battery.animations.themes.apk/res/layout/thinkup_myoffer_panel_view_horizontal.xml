<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/thinkup_myoffer_panel_view_blank"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"/>
    <com.thinkup.core.common.ui.component.RoundImageView
        android:id="@+id/thinkup_myoffer_iv_banner_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="5dp"
        android:scaleType="centerCrop"/>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="12dp"
        android:layout_toRightOf="@+id/thinkup_myoffer_iv_banner_icon"
        android:layout_alignTop="@+id/thinkup_myoffer_panel_view_blank">
        <TextView
            android:textSize="18dp"
            android:textColor="#000000"
            android:id="@+id/thinkup_myoffer_tv_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/thinkup_myoffer_single_line"/>
        <TextView
            android:textSize="@dimen/thinkup_myoffer_half_screen_desc_size_portrait"
            android:textColor="#000000"
            android:ellipsize="end"
            android:id="@+id/thinkup_myoffer_tv_banner_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:maxLines="1"
            style="@style/thinkup_myoffer_single_line.nofontpadding"/>
    </RelativeLayout>
    <com.thinkup.core.common.inner.ui.ScanningAnimButton
        android:layout_gravity="center"
        android:id="@+id/thinkup_myoffer_panel_cta_layout"
        android:background="@drawable/thinkup_myoffer_splash_bg_rectangle_btn_cta_asseblem"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="78dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="24dp"
        android:layout_alignParentBottom="true"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/thinkup_myoffer_include_4_element"/>
</RelativeLayout>
