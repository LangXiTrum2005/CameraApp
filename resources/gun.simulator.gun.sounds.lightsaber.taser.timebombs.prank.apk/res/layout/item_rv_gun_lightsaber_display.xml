<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="18dp"
    android:layout_marginRight="5dp">
    <Space
        android:id="@+id/space_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_gun_display_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_sci_fi_gun"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/space_bottom"
        app:layout_constraintDimensionRatio="h,1008:300"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_top"/>
    <ImageView
        android:id="@+id/iv_gun"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/gun_science_arc"
        app:layout_constraintBottom_toBottomOf="@+id/iv_gun_display_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_gun_display_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_gun_display_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_gun_display_bg"/>
    <ImageView
        android:id="@+id/iv_watch_ad"
        android:layout_width="24dp"
        android:layout_height="15dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ad_label_lock"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_lock"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_watch_ad"/>
    <Space
        android:id="@+id/space_lock_tip_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_gun_display_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_gun_display_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_gun_display_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_gun_display_bg"
        app:layout_constraintVertical_bias="0.557"/>
    <Space
        android:id="@+id/space_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
