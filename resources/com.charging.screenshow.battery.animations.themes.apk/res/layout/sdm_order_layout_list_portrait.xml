<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:id="@+id/sdm_choice_frl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sdm_lv_iv_bg"
        android:background="@drawable/sdm_order_layout_list_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ListView
        android:id="@+id/sdm_order_view_lv"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:listSelector="#00000000"
        android:divider="@null"/>
    <RelativeLayout
        android:id="@+id/sdm_native_order_camp_controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <com.smartdigimkt.expressad.video.dynview.widget.AnyThinkDyImageView
            android:id="@+id/sdm_iv_link"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/sdm_reward_notice"/>
        <com.smartdigimkt.expressad.widget.FeedBackButton
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/sdm_native_order_camp_feed_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:text="@string/sdm_cm_feedback_btn_text"
            android:layout_alignTop="@+id/sdm_iv_link"
            android:layout_toEndOf="@+id/sdm_iv_link"/>
        <com.smartdigimkt.expressad.video.dynview.widget.AnyThinkDyImageView
            android:id="@+id/sdm_order_view_iv_close"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/sdm_reward_close"
            android:layout_alignParentRight="true"
            android:contentDescription="closeButton"/>
        <com.smartdigimkt.expressad.video.dynview.widget.AnyThinkTextView
            android:textSize="12sp"
            android:textColor="@color/sdm_reward_white"
            android:gravity="center"
            android:id="@+id/sdm_tv_reward_status"
            android:background="@drawable/sdm_reward_video_time_count_num_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_marginLeft="5dp"
            android:text="@string/sdm_reward_video_view_reward_time_complete"
            android:layout_alignTop="@+id/sdm_iv_link"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_toEndOf="@+id/sdm_native_order_camp_feed_btn"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/sdm_iv_logo"
        android:layout_width="50dp"
        android:layout_height="18dp"
        android:layout_margin="13dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
