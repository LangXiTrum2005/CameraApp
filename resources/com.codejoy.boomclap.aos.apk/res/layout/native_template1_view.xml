<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp">
    <com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:background="@drawable/bg_corner12"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="245dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#493368">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/background"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:paddingHorizontal="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/middle"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="11dp"
                app:layout_constraintBottom_toTopOf="@+id/media_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:layout_width="@dimen/gnt_no_size"
                    android:layout_height="@dimen/gnt_no_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.utils.widget.ImageFilterView
                        android:id="@+id/icon"
                        android:background="#302542"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:layout_weight="0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toStartOf="@+id/content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:round="5dp"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="vertical"
                        android:id="@+id/content"
                        android:layout_width="@dimen/gnt_no_size"
                        android:layout_height="@dimen/gnt_no_size"
                        android:layout_marginStart="@dimen/gnt_default_margin"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/icon"
                        app:layout_constraintTop_toTopOf="parent">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/headline"
                            android:background="@android:color/transparent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#f09620"
                                android:gravity="center"
                                android:id="@+id/ad_notification_view"
                                android:background="@drawable/bg_ad_notification_view"
                                android:layout_width="23dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="@dimen/gnt_ad_indicator_top_margin"
                                android:text="AD"
                                android:layout_marginEnd="6dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="@dimen/gnt_text_size_large"
                                android:textColor="#e3deff"
                                android:id="@+id/primary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lines="1"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/row_two"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/headline">
                            <TextView
                                android:textSize="12dp"
                                android:textColor="#9d96bb"
                                android:id="@+id/body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
                android:id="@+id/media_view"
                android:background="@drawable/bg_corner9"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#302542"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/middle"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/cta"
                android:background="@drawable/bg_corner12"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:lines="1"
                android:backgroundTint="#f09620"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/media_view"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/holder"
        android:background="@drawable/bg_corner12"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_width="match_parent"
        android:layout_height="245dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#493368"
        android:paddingHorizontal="14dp">
        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/holder_image"
            android:background="@color/native_ad_loading_color"
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:layout_marginTop="11dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:round="5dp"/>
        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/holder_text1"
            android:background="@color/native_ad_loading_color"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="67dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/holder_image"
            app:layout_constraintTop_toTopOf="@+id/holder_image"
            app:round="3dp"/>
        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/holder_text2"
            android:background="@color/native_ad_loading_color"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginTop="9dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="133dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/holder_image"
            app:layout_constraintTop_toBottomOf="@+id/holder_text1"
            app:round="3dp"/>
        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/holder_media"
            android:background="@color/native_ad_loading_color"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/holder_image"
            app:round="5dp"/>
        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:background="@color/native_ad_loading_color"
            android:layout_width="0dp"
            android:layout_height="45dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/holder_media"
            app:round="12dp"/>
        <com.codejoy.boom.clap.ad.native_templates.AdLightingAnimationView
            android:id="@+id/ad_animation_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:gnt_radius="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
