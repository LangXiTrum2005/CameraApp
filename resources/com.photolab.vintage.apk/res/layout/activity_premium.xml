<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#121212"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivClose"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#ffffff"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Store"
        app:layout_constraintBottom_toBottomOf="@+id/ivClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivClose"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutBalance"
        android:background="@drawable/bg_card_premium_normal"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivClose">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/star_icon"
            app:tint="#ffc107"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/tvCreditBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@+id/ivClose">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tabSubscription"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffc107"
                android:id="@+id/tvTabSubscription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUBSCRIPTION"/>
            <View
                android:id="@+id/indicatorSubscription"
                android:background="#ffc107"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tabCredits"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#66ffffff"
                android:id="@+id/tvTabCredits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREDITS"/>
            <View
                android:id="@+id/indicatorCredits"
                android:background="#00000000"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="#33ffffff"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/tabContainer"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomArea"
        app:layout_constraintTop_toBottomOf="@+id/tabContainer">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutSubscription"
                android:padding="24dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Choose Your Plan"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99ffffff"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Unlock pro editing features and AI tools"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cardMonthly"
                    android:background="@drawable/bg_card_premium_normal"
                    android:padding="20dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#99ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MONTHLY"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="#ffffff"
                            android:id="@+id/tvPriceMonthly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$9.99"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#99ffffff"
                            android:layout_gravity="bottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="/ month"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_check"
                                app:tint="#ffc107"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#cccccc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ad-free experience"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_check"
                                app:tint="#ffc107"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#cccccc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100+ premium filters"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/cardYearlyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/cardYearly"
                        android:background="@drawable/bg_card_premium_selected"
                        android:padding="20dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#ffc107"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YEARLY"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="#ffffff"
                                android:id="@+id/tvPriceYearly"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$59.99"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#99ffffff"
                                android:layout_gravity="bottom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="/ year"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#ffc107"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save 50% compared to monthly"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_check"
                                    app:tint="#ffc107"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="#cccccc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ad-free experience"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_check"
                                    app:tint="#ffc107"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="#cccccc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100+ premium filters"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_check"
                                    app:tint="#ffc107"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="#cccccc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="All AI tools &amp; Beta features"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_gravity="end|top"
                        android:background="@drawable/bg_badge_best_value"
                        android:paddingLeft="12dp"
                        android:paddingTop="4dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BEST VALUE"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutCredits"
                android:padding="24dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Refill Your Power"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99ffffff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Unlock premium AI filters and high-res exports"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCreditPackages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_check"
                        app:tint="#ffc107"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#99ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Credits never expire and roll over monthly"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_check"
                        app:tint="#ffc107"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#99ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use credits for AI removal and background replacement"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomArea"
        android:background="#121212"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btnMainAction"
            android:background="@drawable/bg_premium_gold_gradient"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/tvBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subscribe Now"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_forward"
                android:layout_marginStart="8dp"
                app:tint="#000000"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffc107"
            android:layout_gravity="center"
            android:id="@+id/tvRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Restore Purchase"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#66ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvLegal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Subscription automatically renews unless turned off in Account Settings at least 24h before period ends."/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
