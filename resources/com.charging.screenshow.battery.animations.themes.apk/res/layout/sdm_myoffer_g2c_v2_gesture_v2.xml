<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/sdm_myoffer_g2c_item_container"
        android:background="#80000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/sdm_myoffer_g2c_white_line"
            android:layout_width="172dp"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/sdm_myoffer_g2c_gesture_arrow"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/sdm_myoffer_g2c_slide_finger"
            android:layout_width="32dp"
            android:layout_height="46dp"
            android:layout_marginTop="-4dp"
            android:src="@drawable/sdm_myoffer_finger_white_v1"
            android:scaleType="fitCenter"
            android:layout_below="@+id/sdm_myoffer_g2c_white_line"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffff"
            android:id="@+id/sdm_myoffer_g2c_slide_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sdm_myoffer_g2c_slide_to_click2"
            android:layout_below="@+id/sdm_myoffer_g2c_slide_finger"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</merge>
