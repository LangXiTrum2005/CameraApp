<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sdm_myoffer_inctask_close_view"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="110dp"
        android:layout_marginRight="24dp"
        android:src="@drawable/sdm_myoffer_icon_close_with_border"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:layout_below="@+id/sdm_myoffer_inctask_close_view"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="28dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sdm_myoffer_inctask_cts_title"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sdm_myoffer_inctask_cts_subtitle"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/sdm_myoffer_bg_button_radius_12"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">
            <TextView
                android:textSize="20dp"
                android:textColor="#b56200"
                android:gravity="center"
                android:id="@+id/sdm_myoffer_inctask_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="32dp"
                android:text="@string/sdm_myoffer_inctask_cts_hint"/>
            <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
                android:id="@+id/sdm_myoffer_inctask_icon"
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:layout_marginTop="24dp"/>
            <TextView
                android:textSize="20dp"
                android:textColor="#3e2910"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/sdm_myoffer_inctask_desc"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="32dp"
                android:maxLines="1"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="98dp">
                <TextView
                    android:textSize="20dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/sdm_myoffer_inctask_cta"
                    android:background="@drawable/sdm_myoffer_splash_bg_rectangle_btn_cta_asseblem"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="32dp"
                    android:text="@string/sdm_myoffer_inctask_cts_cta_text"
                    android:backgroundTint="#ff2c42"/>
                <com.smartdigimkt.sdk.basead.ui.SimpleGuideToClickView
                    android:id="@+id/sdm_myoffer_g2c_item_g2c_fingerview"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_alignTop="@+id/sdm_myoffer_inctask_cta"
                    android:layout_alignRight="@+id/sdm_myoffer_inctask_cta"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
