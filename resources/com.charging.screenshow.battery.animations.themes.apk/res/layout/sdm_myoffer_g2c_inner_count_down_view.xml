<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sdm_myoffer_g2c_item_close_iv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="110dp"
        android:layout_marginRight="24dp"
        android:src="@drawable/sdm_myoffer_icon_close_with_border"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:layout_below="@+id/sdm_myoffer_g2c_item_close_iv">
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="right"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/sdm_myoffer_g2c_inner_ct_tile_start"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:background="@drawable/sdm_myoffer_bg_red_radius_4"
            android:layout_width="20dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:text="00"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_g2c_ct_min"
            android:background="@drawable/sdm_myoffer_bg_red_radius_4"
            android:layout_width="20dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:text="00"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_g2c_ct_sec"
            android:background="@drawable/sdm_myoffer_bg_red_radius_4"
            android:layout_width="20dp"
            android:layout_height="22dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:text="00"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="left"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/sdm_myoffer_g2c_inner_ct_tile_end"/>
    </LinearLayout>
    <RelativeLayout
        android:background="@drawable/sdm_myoffer_bg_button_radius_12"
        android:layout_width="300dp"
        android:layout_height="340dp"
        android:layout_marginTop="108dp"
        android:layout_below="@+id/sdm_myoffer_g2c_item_close_iv"
        android:layout_centerHorizontal="true"
        android:backgroundTint="#ff2c42">
        <ImageView
            android:id="@+id/sdm_myoffer_g2c_item_ribbon"
            android:layout_width="280dp"
            android:layout_height="118dp"
            android:layout_marginTop="36dp"
            android:scaleType="fitCenter"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="28dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/sdm_myoffer_g2c_inner_ct_title"/>
        <ImageView
            android:id="@+id/sdm_myoffer_g2c_item_gift_icon"
            android:background="@drawable/sdm_myoffer_bg_button_radius_12"
            android:padding="16dp"
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:layout_marginTop="78dp"
            android:scaleType="fitCenter"
            android:layout_centerHorizontal="true"
            android:backgroundTint="#ffffff"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/sdm_myoffer_g2c_inner_ct_subtitle"
            android:maxLines="2"
            android:layout_below="@+id/sdm_myoffer_g2c_item_gift_icon"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#f47500"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_g2c_ct_cta"
            android:background="@drawable/sdm_myoffer_invalid_button_shape_radius_24"
            android:layout_width="236dp"
            android:layout_height="48dp"
            android:layout_marginTop="240dp"
            android:text="@string/sdm_myoffer_g2c_inner_ct_cta"
            android:layout_centerHorizontal="true"
            android:backgroundTint="#ffffff"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ccffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/sdm_myoffer_g2c_inner_ct_hint"
            android:layout_below="@+id/sdm_myoffer_g2c_ct_cta"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
