<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/space_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,456:634"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.4352"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.535"
        app:layout_constraintWidth_percent="0.4222"/>
    <ImageView
        android:id="@+id/iv_bg_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/selector_bomb_start_s"
        app:layout_constraintBottom_toBottomOf="@+id/space_bg"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintEnd_toEndOf="@+id/space_bg"
        app:layout_constraintHorizontal_bias="0.317"
        app:layout_constraintStart_toStartOf="@+id/space_bg"
        app:layout_constraintTop_toTopOf="@+id/space_bg"
        app:layout_constraintVertical_bias="0.2541"/>
    <ImageView
        android:id="@+id/iv_minus_one_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/selector_bomb_time_s"
        app:layout_constraintBottom_toTopOf="@+id/iv_bg_start"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintStart_toEndOf="@+id/iv_bg_start"
        app:layout_constraintTop_toTopOf="@+id/iv_bg_start"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:src="@drawable/ic_minus_1_sec_s"
        app:layout_constraintBottom_toBottomOf="@+id/iv_minus_one_second"
        app:layout_constraintEnd_toEndOf="@+id/iv_minus_one_second"
        app:layout_constraintStart_toStartOf="@+id/iv_minus_one_second"
        app:layout_constraintTop_toTopOf="@+id/iv_minus_one_second"/>
    <ImageView
        android:id="@+id/iv_add_one_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/selector_bomb_time_s"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg_start"
        app:layout_constraintStart_toStartOf="@+id/iv_minus_one_second"
        app:layout_constraintTop_toBottomOf="@+id/iv_bg_start"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:src="@drawable/ic_add_1_sec_s"
        app:layout_constraintBottom_toBottomOf="@+id/iv_add_one_second"
        app:layout_constraintEnd_toEndOf="@+id/iv_add_one_second"
        app:layout_constraintStart_toStartOf="@+id/iv_add_one_second"
        app:layout_constraintTop_toTopOf="@+id/iv_add_one_second"/>
    <TextView
        android:textSize="22sp"
        android:textColor="#e4e6d0"
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:05"
        android:rotation="90"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/space_bg"
        app:layout_constraintEnd_toEndOf="@+id/space_bg"
        app:layout_constraintHorizontal_bias="0.5369"
        app:layout_constraintStart_toStartOf="@+id/space_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_add_one_second"
        app:layout_constraintVertical_bias="0.5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
