<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="98dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.basic.lib.basic.view.RadiusImageView
            android:id="@+id/icon_app"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:radius="30dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#222222"
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:fontFamily="@font/rr"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon_app"
            app:layout_constraintStart_toEndOf="@+id/icon_app"
            app:layout_constraintTop_toTopOf="@+id/icon_app"/>
        <View
            android:id="@+id/oval"
            android:background="@drawable/black_point"
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon_app"
            app:layout_constraintStart_toEndOf="@+id/tv_app_name"
            app:layout_constraintTop_toTopOf="@+id/icon_app"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#222222"
            android:id="@+id/tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/now"
            android:fontFamily="@font/rr"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon_app"
            app:layout_constraintStart_toEndOf="@+id/oval"
            app:layout_constraintTop_toTopOf="@+id/icon_app"/>
        <ImageView
            android:id="@+id/img"
            android:layout_width="7dp"
            android:layout_height="8dp"
            android:src="@drawable/selector_notification_show_or_hide"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon_app"
            app:layout_constraintStart_toEndOf="@+id/tv"
            app:layout_constraintTop_toTopOf="@+id/icon_app"/>
        <TextView
            android:id="@+id/tv_unlocked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="��"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon_app"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#222222"
            android:id="@+id/tv_weapon_unlocked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_weapon_unlocked"
            android:fontFamily="@font/rr"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_unlocked"
            app:layout_constraintStart_toEndOf="@+id/tv_unlocked"
            app:layout_constraintTop_toTopOf="@+id/tv_unlocked"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#686868"
            android:id="@+id/tv_claim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/Claim_your_reward"
            android:fontFamily="@font/rr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_unlocked"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
