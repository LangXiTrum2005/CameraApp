<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@+id/sdm_myoffer_g2c_item_close_iv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="110dp"
        android:layout_marginRight="24dp"
        android:src="@drawable/sdm_myoffer_icon_close_with_border"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:layout_below="@+id/sdm_myoffer_g2c_item_close_iv">
        <TextView
            android:textSize="28dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sdm_myoffer_g2c_puzzle_v2_title"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sdm_myoffer_g2c_puzzle_v2_subtitle"/>
        <RelativeLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:layout_width="292dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="132dp">
            <ImageView
                android:id="@+id/sdm_myoffer_g2c_item_lucky_bag_mask_iv"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:layout_width="116dp"
                android:layout_height="90dp"
                android:src="@drawable/sdm_myoffer_g2c_lucky_bag_mask"
                android:scaleType="fitCenter"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:layout_width="72dp"
                android:layout_height="24dp"
                android:layout_marginTop="54dp"
                android:src="@drawable/sdm_myoffer_g2c_lucky_bag_arrow"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/sdm_myoffer_g2c_puzzle_v2_hint"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/sdm_myoffer_g2c_item_lucky_bag_iv"
                android:layout_width="116dp"
                android:layout_height="126dp"/>
            <ImageView
                android:id="@+id/sdm_myoffer_g2c_item_g2c_finger"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginLeft="66dp"
                android:layout_marginTop="70dp"/>
        </RelativeLayout>
    </LinearLayout>
    <com.smartdigimkt.sdk.basead.ui.guidetoclickv2.picverify.TextSeekbar
        android:id="@+id/sdm_myoffer_g2c_picvertify_seekbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"/>
</merge>
