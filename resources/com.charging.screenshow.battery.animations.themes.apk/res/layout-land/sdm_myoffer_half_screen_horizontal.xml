<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/sdm_dailog_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.smartdigimkt.sdk.basead.ui.RoundCornerRelativeLayout
        android:id="@+id/sdm_myoffer_rl_root"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:layout_marginTop="38dp"
        android:layout_marginBottom="28dp"
        android:layout_centerHorizontal="true">
        <com.smartdigimkt.sdk.basead.ui.PlayerView
            android:id="@+id/sdm_myoffer_player_view_id"
            android:layout_width="match_parent"
            android:layout_height="162dp"/>
        <com.smartdigimkt.sdk.basead.ui.web.WebProgressBarView
            android:id="@+id/sdm_myoffer_player_view_progress_bar_id"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_alignBottom="@+id/sdm_myoffer_player_view_id"/>
        <include layout="@layout/sdm_myoffer_include_guide2click_mask"/>
        <include layout="@layout/sdm_myoffer_include_guide2click_container"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/sdm_myoffer_button_group"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <com.smartdigimkt.sdk.basead.ui.CountDownView
                android:id="@+id/sdm_myoffer_count_down_view_id"
                android:layout_width="@dimen/sdm_myoffer_half_screen_button_size"
                android:layout_height="@dimen/sdm_myoffer_half_screen_button_size"
                android:layout_marginLeft="12dp"
                android:layout_toLeftOf="@+id/sdm_myoffer_btn_close_id"/>
            <com.smartdigimkt.sdk.basead.ui.CloseImageView
                android:id="@+id/sdm_myoffer_btn_close_id"
                android:background="@drawable/sdm_myoffer_base_close_icon"
                android:layout_width="@dimen/sdm_myoffer_half_screen_button_size"
                android:layout_height="@dimen/sdm_myoffer_half_screen_button_size"
                android:layout_marginLeft="12dp"
                android:layout_alignParentRight="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sdm_myoffer_ll_ad_mute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_alignParentLeft="true">
            <TextView
                android:textSize="11dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/sdm_myoffer_ad_lable"
                android:background="@drawable/sdm_myoffer_splash_ad_label_bg"
                android:paddingLeft="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/sdm_basead_ad_text"/>
            <com.smartdigimkt.sdk.basead.ui.MuteImageView
                android:id="@+id/sdm_myoffer_btn_mute_id"
                android:background="@drawable/sdm_myoffer_video_mute_icon"
                android:layout_width="@dimen/sdm_myoffer_half_screen_button_size"
                android:layout_height="@dimen/sdm_myoffer_half_screen_button_size"
                android:layout_marginLeft="12dp"/>
        </LinearLayout>
        <include
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_toRightOf="@+id/sdm_myoffer_ll_ad_mute"
            layout="@layout/sdm_myoffer_feedback_button"/>
        <com.smartdigimkt.sdk.basead.ui.PanelView
            android:id="@+id/sdm_myoffer_banner_view_id"
            android:layout_width="match_parent"
            android:layout_height="162dp"
            android:layout_alignParentBottom="true"/>
    </com.smartdigimkt.sdk.basead.ui.RoundCornerRelativeLayout>
    <include
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_alignTop="@+id/sdm_myoffer_rl_root"
        android:layout_alignBottom="@+id/sdm_myoffer_rl_root"
        android:layout_alignParentLeft="true"
        layout="@layout/sdm_myoffer_include_invalid_button"/>
</RelativeLayout>
