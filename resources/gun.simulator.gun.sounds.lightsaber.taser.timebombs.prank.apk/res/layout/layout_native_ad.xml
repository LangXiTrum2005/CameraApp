<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nativeAdView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.basic.lib.basic.view.RadiusImageView
        android:id="@+id/iv_ad_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0469"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0632"
        app:layout_constraintWidth_percent="0.1728"
        app:radius="2dp"/>
    <ImageView
        android:id="@+id/iv_ad_label"
        android:layout_width="25dp"
        android:layout_height="0dp"
        android:src="@drawable/ad_native_label"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_ad_title"
        app:layout_constraintDimensionRatio="h,25:12"
        app:layout_constraintStart_toEndOf="@+id/iv_ad_title"
        app:layout_constraintTop_toTopOf="@+id/iv_ad_title"
        app:layout_constraintVertical_bias="0.1564"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#fff"
        android:id="@+id/tv_native_ad_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/PrankGuys"
        android:fontFamily="@font/rb"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="104dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_ad_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_ad_label"
        app:layout_constraintTop_toTopOf="@+id/iv_ad_label"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/bt_download"
        android:background="@drawable/bg_bt_ad_download"
        android:padding="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Download"
        android:fontFamily="@font/rb"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_ad_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_native_ad_title"
        app:layout_constraintTop_toTopOf="@+id/iv_ad_title"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#ccffffff"
        android:id="@+id/tv_native_ad_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/Funny_all_in"
        app:layout_constraintBottom_toBottomOf="@+id/iv_ad_title"
        app:layout_constraintEnd_toEndOf="@+id/tv_native_ad_title"
        app:layout_constraintStart_toStartOf="@+id/iv_ad_label"
        app:layout_constraintTop_toBottomOf="@+id/tv_native_ad_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cd_media_view"
        android:background="@drawable/bg_con_media_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_ad_title">
        <FrameLayout
            android:id="@+id/iv_ad_media_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="h,300:166"/>
        <com.basic.lib.basic.view.RadiusImageView
            android:id="@+id/iv_native_placement"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="h,300:166"
            app:radius="2dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
