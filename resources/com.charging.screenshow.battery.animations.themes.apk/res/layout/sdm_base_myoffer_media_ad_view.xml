<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sdm_myoffer_media_ad_container"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/sdm_base_media_view_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentRight="true">
        <com.smartdigimkt.sdk.basead.ui.CloseImageView
            android:layout_gravity="top|right"
            android:id="@+id/sdm_base_media_ad_close"
            android:background="@drawable/sdm_myoffer_base_close_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </FrameLayout>
</RelativeLayout>
