<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.thinkup.core.common.ui.component.RoundImageView
            android:id="@+id/thinkup_myoffer_splash_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <FrameLayout
            android:id="@+id/thinkup_myoffer_splash_ad_content_image_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/thinkup_myoffer_player_view_id"
            android:background="@android:color/black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.thinkup.core.common.inner.ui.MuteImageView
            android:id="@+id/thinkup_myoffer_btn_mute_id"
            android:background="@drawable/thinkup_myoffer_video_mute_icon"
            android:visibility="gone"
            android:layout_width="@dimen/thinkup_myoffer_half_screen_button_size"
            android:layout_height="@dimen/thinkup_myoffer_half_screen_button_size"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"/>
        <include
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:layout_toRightOf="@+id/thinkup_myoffer_btn_mute_id"
            layout="@layout/thinkup_myoffer_feedback_button"/>
        <ImageView
            android:id="@+id/thinkup_myoffer_player_view_cover_img_id"
            android:background="#fafafa"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/thinkup_myoffer_player_view_cover_icon_id"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/thinkup_player_view_placeholder_icon"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/thinkup_myoffer_splash_skip_area"
        android:layout_alignBottom="@+id/thinkup_myoffer_splash_skip_area"
        layout="@layout/thinkup_myoffer_include_splash_ad_layout_ad_label"/>
    <include layout="@layout/thinkup_myoffer_include_guide2click_mask"/>
    <RelativeLayout
        android:id="@+id/thinkup_myoffer_splash_ad_bottom_container"
        android:background="@drawable/thinkup_myoffer_splash_bg_info"
        android:paddingTop="66dp"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_alignParentBottom="true">
        <com.thinkup.core.common.ui.component.RoundImageView
            android:id="@+id/thinkup_myoffer_splash_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="18dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-4dp"
            android:layout_marginRight="24dp"
            android:layout_toRightOf="@+id/thinkup_myoffer_splash_icon"
            android:layout_alignTop="@+id/thinkup_myoffer_splash_icon"
            android:layout_alignBottom="@+id/thinkup_myoffer_splash_icon">
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/thinkup_myoffer_splash_ad_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:lineSpacingMultiplier="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/thinkup_myoffer_splash_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:lineSpacingMultiplier="1"/>
        </LinearLayout>
        <com.thinkup.core.common.inner.ui.ScanningAnimButton
            android:id="@+id/thinkup_myoffer_splash_ad_cta_layout"
            android:background="@drawable/thinkup_myoffer_splash_bg_rectangle_btn_cta_asseblem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="24dp"
            android:layout_below="@+id/thinkup_myoffer_splash_icon"/>
        <include
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/thinkup_myoffer_splash_ad_cta_layout"
            layout="@layout/thinkup_myoffer_include_invalid_button"/>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/thinkup_myoffer_include_4_element"/>
    <include layout="@layout/thinkup_myoffer_include_guide2click_container"/>
    <include layout="@layout/thinkup_myoffer_include_splash_ad_layout_skip_area"/>
</merge>
