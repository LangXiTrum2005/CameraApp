<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
        android:id="@+id/sdm_myoffer_splash_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.smartdigimkt.sdk.basead.ui.WrapRoundImageView
        android:id="@+id/sdm_myoffer_splash_ad_content_image_area"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <com.smartdigimkt.sdk.basead.ui.PlayerView
        android:id="@+id/sdm_myoffer_player_view_id"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.smartdigimkt.sdk.basead.ui.MuteImageView
        android:id="@+id/sdm_myoffer_btn_mute_id"
        android:background="@drawable/sdm_myoffer_video_mute_icon"
        android:visibility="gone"
        android:layout_width="@dimen/sdm_myoffer_half_screen_button_size"
        android:layout_height="@dimen/sdm_myoffer_half_screen_button_size"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"/>
    <include
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:layout_toRightOf="@+id/sdm_myoffer_btn_mute_id"
        layout="@layout/sdm_myoffer_feedback_button"/>
    <ImageView
        android:id="@+id/sdm_myoffer_player_view_cover_img_id"
        android:background="#fafafa"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/sdm_myoffer_player_view_cover_icon_id"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/sdm_player_view_placeholder_icon"
        android:layout_centerInParent="true"/>
    <include layout="@layout/sdm_myoffer_include_guide2click_mask"/>
    <com.smartdigimkt.sdk.basead.ui.component.LargeCTAButtonLayout
        android:id="@+id/sdm_myoffer_splash_ad_cta_layout"
        android:layout_width="300dp"
        android:layout_height="@dimen/sdm_myoffer_splash_cta_height"
        android:layout_marginBottom="92dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="44dp"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_invalid_button"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_4_element_withbg"/>
    <include layout="@layout/sdm_myoffer_include_guide2click_container"/>
    <include layout="@layout/sdm_myoffer_include_splash_ad_layout_skip_area"/>
</merge>
