<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="@string/settings"
            android:layout_centerVertical="true"
            android:textAllCaps="true"
            android:fontFamily="@font/fredoka_one_regular"
            android:layout_marginStart="16dp"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_item_32dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="8dp">
        <RelativeLayout
            android:id="@+id/rlRate"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_title_item"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_us"
                android:layout_centerVertical="true"
                android:fontFamily="@string/Roboto_Regular"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_right"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlShare"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_title_item"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_app"
                android:layout_centerVertical="true"
                android:fontFamily="@string/Roboto_Regular"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_right"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlPrivacy"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_title_item"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                android:layout_centerVertical="true"
                android:fontFamily="@string/Roboto_Regular"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_right"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_title_item"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version"
                android:layout_centerVertical="true"
                android:fontFamily="@string/Roboto_Regular"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_content_item"
                android:gravity="center"
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version"
                android:layout_centerVertical="true"
                android:alpha="0.4"
                android:fontFamily="@string/Roboto_Regular"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
