<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_scene_russain_roulette"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.StatusBarFitView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <VideoView
        android:id="@+id/vv_scene"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/fl_spine"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/surface_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_mask_top"
        android:background="@drawable/iv_bottom_mask_reload"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:rotation="180"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.2125"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/status_bar"/>
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/icon_back"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar"/>
    <ImageView
        android:id="@+id/iv_immersive"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/icon_selector_immersive"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_back"/>
    <ImageView
        android:id="@+id/iv_setting"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_russian_roulette_settings"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_immersive"/>
    <ImageView
        android:id="@+id/iv_help"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_russian_roulette_help"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_setting"/>
    <ImageView
        android:id="@+id/iv_scene"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_scene_menu"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_help"/>
    <ImageView
        android:id="@+id/iv_firing_effect"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_mechanical_fire_effect"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_scene"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/tvReload"
        android:background="@drawable/bg_reload_bt"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="12dp"
        android:paddingBottom="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:minWidth="89dp"
        android:text="@string/Reload"
        android:rotation="90"
        android:fontFamily="@font/gb"
        android:letterSpacing="0.03"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_firing_effect"
        app:layout_constraintStart_toStartOf="@+id/iv_firing_effect"
        app:layout_constraintTop_toBottomOf="@+id/iv_firing_effect"/>
    <ImageView
        android:id="@+id/iv_bullet"
        android:layout_width="51dp"
        android:layout_height="51dp"
        android:src="@drawable/icon_cartridge_mechanical_gun"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/con_weapon_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar"
        app:layout_constraintVertical_bias="0.9434"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/tv_bullet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:fontFamily="@font/rbi"
        app:layout_constraintEnd_toEndOf="@+id/iv_bullet"
        app:layout_constraintStart_toStartOf="@+id/iv_bullet"
        app:layout_constraintTop_toBottomOf="@+id/iv_bullet"/>
    <ImageView
        android:id="@+id/iv_mask_bottom"
        android:background="@drawable/iv_bottom_mask_reload"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/con_weapon_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.25"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/tv_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="21dp"
        android:layout_marginRight="21dp"
        android:layout_marginBottom="21dp"
        android:text="@string/Tap_Bullet_Chambers_to_Load_or_Unload"
        android:alpha="0"
        android:layout_marginHorizontal="21dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_reload_done"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/tv_reload_done"
        android:background="@drawable/bt_rate_bg_light"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="36dp"
        android:text="@string/Done"
        android:alpha="0"
        android:fontFamily="@font/rbi"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintBottom_toTopOf="@+id/con_weapon_banner"
        app:layout_constraintDimensionRatio="h,280:54"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_reload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_firing_effect,tv_bullet,iv_bullet,tvReload,iv_help,iv_setting,iv_immersive,iv_scene"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_reload_done"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_reload_done,tv_guide,iv_mask_bottom,iv_mask_top"/>
    <View
        android:id="@+id/mask"
        android:background="#000"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@+id/con_weapon_banner"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_weapon_banner"
        android:background="#252834"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/strokeViewTop"
            android:background="#808289"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/layout_russain_roulette_guide"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lav_shoot_warn"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_fileName="shoot_warn/data.json"
        app:lottie_imageAssetsFolder="shoot_warn/images"
        app:lottie_loop="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
