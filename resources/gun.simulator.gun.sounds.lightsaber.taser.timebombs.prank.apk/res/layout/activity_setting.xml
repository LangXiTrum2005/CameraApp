<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.StatusBarFitView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_title"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/icon_back"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_weapon_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:fontFamily="@font/gb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/con_title"
            app:layout_constraintStart_toStartOf="@+id/con_title"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/layout"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/con_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/layout_all_weapons"
                android:background="@drawable/bg_settings_part"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/switch_firing_sound"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:id="@+id/tv_all_weapons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/all_weapons"
                android:fontFamily="@font/gr"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_flash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_flash"
                app:layout_constraintBottom_toBottomOf="@+id/switch_flash"
                app:layout_constraintStart_toStartOf="@+id/tv_all_weapons"
                app:layout_constraintTop_toTopOf="@+id/switch_flash"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_flash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/flash"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_flash"
                app:layout_constraintEnd_toStartOf="@+id/switch_flash"
                app:layout_constraintStart_toEndOf="@+id/iv_flash"
                app:layout_constraintTop_toTopOf="@+id/iv_flash"/>
            <CheckBox
                android:id="@+id/switch_flash"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:button="@null"
                app:layout_constraintBottom_toTopOf="@+id/switch_screen_flash"
                app:layout_constraintEnd_toEndOf="@+id/tv_all_weapons"
                app:layout_constraintTop_toBottomOf="@+id/tv_all_weapons"/>
            <ImageView
                android:id="@+id/iv_screen_flash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_screen_flash"
                app:layout_constraintBottom_toBottomOf="@+id/switch_screen_flash"
                app:layout_constraintStart_toStartOf="@+id/iv_flash"
                app:layout_constraintTop_toTopOf="@+id/switch_screen_flash"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_screen_flash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/screen_flash"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_screen_flash"
                app:layout_constraintEnd_toStartOf="@+id/switch_screen_flash"
                app:layout_constraintStart_toEndOf="@+id/iv_screen_flash"
                app:layout_constraintTop_toTopOf="@+id/iv_screen_flash"/>
            <CheckBox
                android:id="@+id/switch_screen_flash"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                app:layout_constraintBottom_toTopOf="@+id/switch_haptic"
                app:layout_constraintEnd_toEndOf="@+id/tv_all_weapons"
                app:layout_constraintTop_toBottomOf="@+id/switch_flash"/>
            <ImageView
                android:id="@+id/iv_haptic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_haptic"
                app:layout_constraintBottom_toBottomOf="@+id/switch_haptic"
                app:layout_constraintStart_toStartOf="@+id/iv_screen_flash"
                app:layout_constraintTop_toTopOf="@+id/switch_haptic"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_haptic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/haptic"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_haptic"
                app:layout_constraintEnd_toStartOf="@+id/switch_haptic"
                app:layout_constraintStart_toEndOf="@+id/iv_haptic"
                app:layout_constraintTop_toTopOf="@+id/iv_haptic"/>
            <CheckBox
                android:id="@+id/switch_haptic"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                app:layout_constraintBottom_toTopOf="@+id/switch_firing_sound"
                app:layout_constraintEnd_toEndOf="@+id/tv_all_weapons"
                app:layout_constraintTop_toBottomOf="@+id/switch_screen_flash"/>
            <ImageView
                android:id="@+id/iv_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sound"
                app:layout_constraintBottom_toBottomOf="@+id/switch_firing_sound"
                app:layout_constraintStart_toStartOf="@+id/iv_haptic"
                app:layout_constraintTop_toTopOf="@+id/switch_firing_sound"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_sound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/firing_sound"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_sound"
                app:layout_constraintEnd_toStartOf="@+id/switch_firing_sound"
                app:layout_constraintStart_toEndOf="@+id/iv_sound"
                app:layout_constraintTop_toTopOf="@+id/iv_sound"/>
            <CheckBox
                android:id="@+id/switch_firing_sound"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                app:layout_constraintEnd_toEndOf="@+id/tv_all_weapons"
                app:layout_constraintTop_toBottomOf="@+id/switch_haptic"/>
            <View
                android:id="@+id/layout_machine_gun"
                android:background="@drawable/bg_settings_part"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/switch_bullet"
                app:layout_constraintTop_toBottomOf="@+id/layout_all_weapons"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:id="@+id/tv_machine_gun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/machine_gun"
                android:fontFamily="@font/gr"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_all_weapons"/>
            <ImageView
                android:id="@+id/iv_bullet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_bullet"
                app:layout_constraintBottom_toBottomOf="@+id/switch_bullet"
                app:layout_constraintStart_toStartOf="@+id/tv_machine_gun"
                app:layout_constraintTop_toTopOf="@+id/switch_bullet"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_bullet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/bullet_drop"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_bullet"
                app:layout_constraintEnd_toStartOf="@+id/switch_bullet"
                app:layout_constraintStart_toEndOf="@+id/iv_bullet"
                app:layout_constraintTop_toTopOf="@+id/iv_bullet"/>
            <CheckBox
                android:id="@+id/switch_bullet"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:button="@null"
                app:layout_constraintEnd_toEndOf="@+id/tv_machine_gun"
                app:layout_constraintTop_toBottomOf="@+id/tv_machine_gun"/>
            <View
                android:id="@+id/layout_light_saber"
                android:background="@drawable/bg_settings_part"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/switch_shake_sound"
                app:layout_constraintTop_toBottomOf="@+id/layout_machine_gun"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:id="@+id/tv_light_saber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/lightsaber"
                android:fontFamily="@font/gr"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_machine_gun"/>
            <ImageView
                android:id="@+id/iv_shake_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_shake_sound"
                app:layout_constraintBottom_toBottomOf="@+id/switch_shake_sound"
                app:layout_constraintStart_toStartOf="@+id/tv_light_saber"
                app:layout_constraintTop_toTopOf="@+id/switch_shake_sound"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_shake_sound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/shake_sound"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_shake_sound"
                app:layout_constraintEnd_toStartOf="@+id/switch_shake_sound"
                app:layout_constraintStart_toEndOf="@+id/iv_shake_sound"
                app:layout_constraintTop_toTopOf="@+id/iv_shake_sound"/>
            <CheckBox
                android:id="@+id/switch_shake_sound"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:button="@null"
                app:layout_constraintEnd_toEndOf="@+id/tv_light_saber"
                app:layout_constraintTop_toBottomOf="@+id/tv_light_saber"/>
            <View
                android:id="@+id/layout_time_bomb"
                android:background="@drawable/bg_settings_part"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/switch_explosion"
                app:layout_constraintTop_toBottomOf="@+id/layout_light_saber"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:id="@+id/tv_time_bomb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/time_bomb"
                android:fontFamily="@font/gr"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_light_saber"/>
            <ImageView
                android:id="@+id/iv_explosion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_explosion"
                app:layout_constraintBottom_toBottomOf="@+id/switch_explosion"
                app:layout_constraintStart_toStartOf="@+id/tv_time_bomb"
                app:layout_constraintTop_toTopOf="@+id/switch_explosion"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_explosion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/effect_after_explosion"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_explosion"
                app:layout_constraintEnd_toStartOf="@+id/switch_explosion"
                app:layout_constraintStart_toEndOf="@+id/iv_explosion"
                app:layout_constraintTop_toTopOf="@+id/iv_explosion"/>
            <CheckBox
                android:id="@+id/switch_explosion"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:button="@null"
                app:layout_constraintEnd_toEndOf="@+id/tv_time_bomb"
                app:layout_constraintTop_toBottomOf="@+id/tv_time_bomb"/>
            <View
                android:id="@+id/layout_app"
                android:background="@drawable/bg_settings_part"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/switch_bgm"
                app:layout_constraintTop_toBottomOf="@+id/layout_time_bomb"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:id="@+id/tv_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/app"
                android:fontFamily="@font/gr"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_time_bomb"/>
            <ImageView
                android:id="@+id/iv_click_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_click_sound"
                app:layout_constraintBottom_toBottomOf="@+id/switch_click_sound"
                app:layout_constraintStart_toStartOf="@+id/tv_app"
                app:layout_constraintTop_toTopOf="@+id/switch_click_sound"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_click_sound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/button_click_sound"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_click_sound"
                app:layout_constraintEnd_toStartOf="@+id/switch_click_sound"
                app:layout_constraintStart_toEndOf="@+id/iv_click_sound"
                app:layout_constraintTop_toTopOf="@+id/iv_click_sound"/>
            <CheckBox
                android:id="@+id/switch_click_sound"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:button="@null"
                app:layout_constraintBottom_toTopOf="@+id/switch_bgm"
                app:layout_constraintEnd_toEndOf="@+id/tv_app"
                app:layout_constraintTop_toBottomOf="@+id/tv_app"/>
            <ImageView
                android:id="@+id/iv_bgm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_bgm"
                app:layout_constraintBottom_toBottomOf="@+id/switch_bgm"
                app:layout_constraintStart_toStartOf="@+id/tv_app"
                app:layout_constraintTop_toTopOf="@+id/switch_bgm"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_bgm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/background_music"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_bgm"
                app:layout_constraintEnd_toStartOf="@+id/switch_bgm"
                app:layout_constraintStart_toEndOf="@+id/iv_bgm"
                app:layout_constraintTop_toTopOf="@+id/iv_bgm"/>
            <CheckBox
                android:id="@+id/switch_bgm"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                app:layout_constraintEnd_toEndOf="@+id/tv_app"
                app:layout_constraintTop_toBottomOf="@+id/switch_click_sound"/>
            <View
                android:id="@+id/layout_about_us"
                android:background="@drawable/bg_settings_part"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/switch_privacy_policy"
                app:layout_constraintTop_toBottomOf="@+id/layout_app"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:id="@+id/tv_about_us"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/about_us"
                android:fontFamily="@font/gr"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_app"/>
            <ImageView
                android:id="@+id/iv_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_rate"
                app:layout_constraintBottom_toBottomOf="@+id/switch_rate"
                app:layout_constraintStart_toStartOf="@+id/tv_about_us"
                app:layout_constraintTop_toTopOf="@+id/switch_rate"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_rate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/rate_5_stars"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_rate"
                app:layout_constraintEnd_toStartOf="@+id/switch_rate"
                app:layout_constraintStart_toEndOf="@+id/iv_rate"
                app:layout_constraintTop_toTopOf="@+id/iv_rate"/>
            <Space
                android:id="@+id/switch_rate"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                app:layout_constraintBottom_toTopOf="@+id/switch_more_apps"
                app:layout_constraintEnd_toEndOf="@+id/tv_about_us"
                app:layout_constraintTop_toBottomOf="@+id/tv_about_us"/>
            <View
                android:id="@+id/layout_rate"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/switch_rate"
                app:layout_constraintEnd_toEndOf="@+id/tv_about_us"
                app:layout_constraintStart_toStartOf="@+id/tv_about_us"
                app:layout_constraintTop_toTopOf="@+id/switch_rate"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="layout_rate,switch_rate,tv_rate,iv_rate"/>
            <ImageView
                android:id="@+id/iv_more_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_more_our_apps"
                app:layout_constraintBottom_toBottomOf="@+id/switch_more_apps"
                app:layout_constraintStart_toStartOf="@+id/tv_about_us"
                app:layout_constraintTop_toTopOf="@+id/switch_more_apps"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_more_apps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/more_our_apps"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_more_apps"
                app:layout_constraintEnd_toStartOf="@+id/switch_more_apps"
                app:layout_constraintStart_toEndOf="@+id/iv_more_apps"
                app:layout_constraintTop_toTopOf="@+id/iv_more_apps"/>
            <Space
                android:id="@+id/switch_more_apps"
                android:background="@drawable/selector_setting_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                app:layout_constraintBottom_toTopOf="@+id/switch_share"
                app:layout_constraintEnd_toEndOf="@+id/tv_about_us"
                app:layout_constraintTop_toBottomOf="@+id/switch_rate"/>
            <View
                android:id="@+id/layout_more_apps"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/switch_more_apps"
                app:layout_constraintEnd_toEndOf="@+id/tv_about_us"
                app:layout_constraintStart_toStartOf="@+id/tv_about_us"
                app:layout_constraintTop_toTopOf="@+id/switch_more_apps"/>
            <ImageView
                android:id="@+id/iv_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_share"
                app:layout_constraintBottom_toBottomOf="@+id/switch_share"
                app:layout_constraintStart_toStartOf="@+id/tv_about_us"
                app:layout_constraintTop_toTopOf="@+id/switch_share"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/share_app"
                android:fontFamily="sans-serif-medium"
