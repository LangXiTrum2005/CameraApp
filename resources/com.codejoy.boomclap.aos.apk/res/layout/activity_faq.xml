<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHead"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,750:118"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/boomclap_bg_page_top_3"/>
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="20dp"
            android:textColor="@color/color_B0A5F4"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/how_to_use"
            app:customFontWeight="semibold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4"
            app:layout_constraintWidth_percent="0.4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="67dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="20dp"
        android:baselineAligned="false"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/clHead">
        <FrameLayout
            android:id="@+id/clapModeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:background="@drawable/selector_gradient_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.codejoy.boom.clap.widget.ParkinsansFontText
                android:textSize="17dp"
                android:textColor="#fff0eeff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="@string/clap_mode_title"
                android:includeFontPadding="false"
                app:customFontWeight="bold"
                app:lineHeight="17dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/touchModeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">
            <View
                android:background="@drawable/selector_gradient_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.codejoy.boom.clap.widget.ParkinsansFontText
                android:textSize="17dp"
                android:textColor="#fff0eeff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="@string/touch_mode_title"
                android:includeFontPadding="false"
                app:customFontWeight="bold"
                app:lineHeight="17dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/pocketModeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:background="@drawable/selector_gradient_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.codejoy.boom.clap.widget.ParkinsansFontText
                android:textSize="17dp"
                android:textColor="#fff0eeff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="@string/pocket_mode_title"
                android:includeFontPadding="false"
                app:customFontWeight="bold"
                app:lineHeight="17dp"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-40dp"
        android:layout_marginStart="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clHead">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/boomclap_ic_sound_back"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
