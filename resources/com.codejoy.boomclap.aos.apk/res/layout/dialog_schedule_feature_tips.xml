<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/topPopupLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/boomclap_bg_pop_top"
        app:layout_constraintDimensionRatio="375:227"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="#ff100b18"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topPopupLayout"/>
    <Space
        android:orientation="horizontal"
        android:id="@+id/spacer"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/topPopupLayout"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/spacer">
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="24dp"
            android:textColor="#ffe3deff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:text="@string/what_is_feature_title"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="30dp"
            app:customFontWeight="semibold"/>
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="20dp"
            android:textColor="#ff9d96bb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="30dp"
            android:text="@string/what_is_feature_tip"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="30dp"
            app:customFontWeight="regular"
            app:lineHeight="26dp"/>
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="24dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/okButton"
            android:background="@drawable/bg_gradient_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="36dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="30dp"
            android:text="@string/ok"
            android:layout_marginHorizontal="30dp"
            app:customFontWeight="semibold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
