<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/icon_back"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/space_top_bar"
        app:layout_constraintStart_toStartOf="@+id/space_top_bar"
        app:layout_constraintTop_toTopOf="@+id/space_top_bar"/>
    <ImageView
        android:id="@+id/iv_setting"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_setting"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/space_top_bar"
        app:layout_constraintEnd_toEndOf="@+id/space_top_bar"
        app:layout_constraintTop_toTopOf="@+id/space_top_bar"/>
    <ImageView
        android:id="@+id/iv_immersive"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/icon_selector_immersive"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_top_bar"/>
    <ImageView
        android:id="@+id/iv_color_choose"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_bg_color_choose"
        app:layout_constraintStart_toStartOf="@+id/iv_back"
        app:layout_constraintTop_toBottomOf="@+id/iv_immersive"/>
    <com.mikhaellopez.circleview.CircleView
        android:id="@+id/cv_color_choose"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:cv_border="true"
        app:cv_border_color="@color/white"
        app:cv_border_width="1dp"
        app:cv_color="#f00"
        app:layout_constraintBottom_toBottomOf="@+id/iv_color_choose"
        app:layout_constraintEnd_toEndOf="@+id/iv_color_choose"
        app:layout_constraintStart_toStartOf="@+id/iv_color_choose"
        app:layout_constraintTop_toTopOf="@+id/iv_color_choose"/>
    <ImageView
        android:id="@+id/iv_color_picker"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/icon_color_picker"
        app:layout_constraintBottom_toBottomOf="@+id/iv_color_choose"
        app:layout_constraintEnd_toEndOf="@+id/iv_color_choose"
        app:layout_constraintStart_toStartOf="@+id/iv_color_choose"
        app:layout_constraintTop_toTopOf="@+id/iv_color_choose"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_color_choose"
        android:background="@drawable/bg_con_choose_color"
        android:visibility="invisible"
        android:layout_width="44dp"
        android:layout_height="200dp"
        android:layout_marginTop="68dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_immersive"
        app:layout_constraintStart_toStartOf="@+id/iv_immersive"
        app:layout_constraintTop_toBottomOf="@+id/iv_immersive">
        <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.ColorSeekBarVertical
            android:id="@+id/choose_color_seek_bar"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:barWidth="12dp"
            app:bgPadding="3dp"
            app:cornerRadius="38dp"
            app:layout_constraintBottom_toTopOf="@+id/iv_reset_color_choose"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:thumbBg="@drawable/icon_color_choose_thumb"/>
        <ImageView
            android:id="@+id/iv_reset_color_choose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/icon_reset_color_choose"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_shake"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/icon_shake"
        app:layout_constraintEnd_toEndOf="@+id/iv_setting"
        app:layout_constraintTop_toBottomOf="@+id/iv_setting"/>
    <ImageView
        android:id="@+id/iv_scene_menu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_scene_menu"
        app:layout_constraintEnd_toEndOf="@+id/iv_shake"
        app:layout_constraintTop_toBottomOf="@+id/iv_shake"/>
    <ImageView
        android:id="@+id/iv_gun_effect"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_mechanical_fire_effect"
        app:layout_constraintEnd_toEndOf="@+id/iv_scene_menu"
        app:layout_constraintTop_toBottomOf="@+id/iv_scene_menu"/>
    <ImageView
        android:id="@+id/iv_unlimited_bullet"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_unlimited_bullet"
        app:layout_constraintEnd_toEndOf="@+id/iv_gun_effect"
        app:layout_constraintTop_toBottomOf="@+id/iv_gun_effect"/>
    <ImageView
        android:id="@+id/iv_watch_ad"
        android:layout_width="24dp"
        android:layout_height="15dp"
        android:src="@drawable/label_watch_ad"
        app:layout_constraintBottom_toBottomOf="@+id/iv_unlimited_bullet"
        app:layout_constraintEnd_toEndOf="@+id/iv_unlimited_bullet"/>
    <View
        android:id="@+id/layout_click_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_bullets"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_separator_bullets_number"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_bullets_number_in_cartridge_clip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="80"
        android:fontFamily="@font/rm"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_separator_bullets_number"
        app:layout_constraintEnd_toStartOf="@+id/tv_separator_bullets_number"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/iv_bullets"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_separator_bullets_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="/"
        android:fontFamily="@font/rm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_bullets_number_all"
        app:layout_constraintStart_toEndOf="@+id/tv_bullets_number_in_cartridge_clip"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_bullets_number_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:fontFamily="@font/rm"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_separator_bullets_number"
        app:layout_constraintEnd_toEndOf="@+id/iv_bullets"
        app:layout_constraintStart_toEndOf="@+id/tv_separator_bullets_number"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_unlimited"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="∞"
        android:fontFamily="@font/rm"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_bullets_number_in_cartridge_clip"
        app:layout_constraintEnd_toEndOf="@+id/kpb_bullets_number"
        app:layout_constraintStart_toStartOf="@+id/kpb_bullets_number"/>
    <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.KnobProgressBar
        android:id="@+id/kpb_bullets_number"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:android_min="0"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bullets"
        app:layout_constraintEnd_toEndOf="@+id/iv_bullets"
        app:layout_constraintStart_toStartOf="@+id/iv_bullets"
        app:layout_constraintTop_toTopOf="@+id/iv_bullets"
        app:progressBg="@drawable/bg_technology_gun_pb"
        app:progressFg="@drawable/fg_technology_gun_pb"
        app:progressSrc="@drawable/src_technology_gun_pb"
        app:scaleEnd="335"
        app:scaleStart="25"/>
</merge>
