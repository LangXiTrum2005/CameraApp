<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true">
        <com.thinkup.core.common.ui.component.RoundImageView
            android:id="@+id/thinkup_myoffer_iv_banner_icon"
            android:background="@drawable/thinkup_myoffer_bg_circle_white"
            android:padding="20dp"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:backgroundTint="#f5f5f5"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/thinkup_myoffer_tv_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/thinkup_myoffer_single_line.nofontpadding"/>
        <TextView
            android:textSize="@dimen/thinkup_myoffer_half_screen_desc_size_portrait"
            android:textColor="#000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/thinkup_myoffer_tv_banner_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            style="@style/thinkup_myoffer_single_line.nofontpadding"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="28dp"/>
        <com.thinkup.core.common.inner.ui.ScanningAnimButton
            android:layout_gravity="center"
            android:id="@+id/thinkup_myoffer_panel_cta_layout"
            android:background="@drawable/thinkup_myoffer_splash_bg_rectangle_btn_cta_asseblem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            style="@style/thinkup_myoffer_single_line"/>
        <include
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/thinkup_myoffer_include_invalid_button"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/thinkup_myoffer_include_4_element"/>
</RelativeLayout>
