<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.StatusBarFitView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_warning"
        android:background="@drawable/bg_dialog_warn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar"
        app:layout_constraintWidth_percent="0.9">
        <ImageView
            android:id="@+id/iv_weapon_bullet"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="31dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.2905"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.216"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/tv_out_of_ammo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="11dp"
            android:text="@string/Out_of_ammo"
            android:fontFamily="@font/gb"
            android:layout_marginHorizontal="11dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_weapon_bullet"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#c7ffffff"
            android:gravity="center"
            android:id="@+id/tv_please_reload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginRight="11dp"
            android:text="@string/Please_reload_your_weapon"
            android:fontFamily="@font/rr"
            android:layout_marginHorizontal="11dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_out_of_ammo"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/bt_reload"
            android:background="@drawable/selector_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="39dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="39dp"
            android:layout_marginBottom="25dp"
            android:text="@string/RELOAD"
            android:fontFamily="@font/gb"
            android:layout_marginHorizontal="39dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="h,49:243"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_please_reload"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/tv_title_warn"
        android:background="@drawable/bg_title_warn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-10dp"
        android:text="@string/WARNING"
        android:fontFamily="@font/gb"
        app:layout_constraintEnd_toEndOf="@+id/con_warning"
        app:layout_constraintHeight_percent="0.0469"
        app:layout_constraintStart_toStartOf="@+id/con_warning"
        app:layout_constraintTop_toTopOf="@+id/con_warning"
        app:layout_constraintWidth_percent="0.6472"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_native_ad_placement"
        android:background="@drawable/bg_ad_reload_dialog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="31dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,324:303"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/con_warning"
        app:layout_constraintWidth_percent="0.9"/>
</androidx.constraintlayout.widget.ConstraintLayout>
