<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sdm_myoffer_banner_root"
    android:background="@drawable/sdm_myoffer_bg_banner"
    android:layout_width="320dp"
    android:layout_height="90dp">
    <FrameLayout
        android:id="@+id/sdm_myoffer_main_resouce_container"
        android:background="@drawable/sdm_myoffer_bg_banner_native"
        android:visibility="gone"
        android:clipChildren="true"
        android:layout_width="90dp"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="6sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/sdm_myoffer_ad_lable"
        android:background="@drawable/sdm_myoffer_splash_ad_label_bg"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:text="@string/sdm_basead_ad_text"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="6dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/sdm_myoffer_banner_ad_from"
        android:background="#888888"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_toRightOf="@+id/sdm_myoffer_ad_lable"
        android:layout_alignTop="@+id/sdm_myoffer_ad_lable"
        android:layout_alignBottom="@+id/sdm_myoffer_ad_lable"/>
    <FrameLayout
        android:id="@+id/sdm_myoffer_banner_icon_container"
        android:clipChildren="true"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="9dp"
        android:layout_toRightOf="@+id/sdm_myoffer_main_resouce_container"
        android:layout_alignParentTop="true">
        <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
            android:id="@+id/sdm_myoffer_banner_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sdm_ll_title_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="10dp"
        android:layout_toRightOf="@+id/sdm_myoffer_banner_icon_container"
        android:layout_alignTop="@+id/sdm_myoffer_banner_icon_container"
        android:layout_alignBottom="@+id/sdm_myoffer_banner_icon_container">
        <com.smartdigimkt.sdk.basead.ui.component.NoShadowMarqueeTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:ellipsize="marquee"
            android:gravity="left"
            android:id="@+id/sdm_myoffer_banner_ad_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"/>
        <com.smartdigimkt.sdk.basead.ui.component.NoShadowMarqueeTextView
            android:textSize="12dp"
            android:textColor="#000000"
            android:ellipsize="marquee"
            android:gravity="left"
            android:id="@+id/sdm_myoffer_banner_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"/>
    </LinearLayout>
    <com.smartdigimkt.sdk.basead.ui.CloseImageView
        android:id="@+id/sdm_myoffer_banner_close"
        android:background="#a0a0a0"
        android:padding="1dp"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/sdm_browser_close_icon"
        android:tint="#ffffff"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <com.smartdigimkt.sdk.basead.ui.ScanningAnimButton
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/sdm_myoffer_banner_ad_install_btn"
        android:background="@drawable/sdm_myoffer_splash_bg_rectangle_btn_cta_asseblem"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_toRightOf="@+id/sdm_myoffer_main_resouce_container"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        style="@style/sdm_myoffer_single_line"/>
    <include layout="@layout/sdm_myoffer_include_4_element_banner"/>
</RelativeLayout>
