<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="22dp">
    <RelativeLayout
        android:id="@+id/sdm_myoffer_four_element_container"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="22dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sdm_myoffer_four_element_container_subinfo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TextView
                android:textSize="10dp"
                android:textColor="#a0a0a0"
                android:id="@+id/sdm_myoffer_disclaimer"
                android:paddingLeft="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sdm_myoffer_panel_disclaimer"
                style="@style/sdm_myoffer_banner_privacy_text_style"/>
            <View
                android:id="@+id/sdm_myoffer_center_line3"
                android:background="#a0a0a0"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="2dp"/>
            <com.smartdigimkt.sdk.basead.ui.component.MarqueeTextView
                android:textSize="10dp"
                android:textColor="#a0a0a0"
                android:id="@+id/sdm_myoffer_version_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#a0a0a0"
                android:id="@+id/sdm_myoffer_privacy_agreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sdm_myoffer_panel_privacy"
                style="@style/sdm_myoffer_banner_privacy_text_style"/>
            <View
                android:id="@+id/sdm_myoffer_center_line1"
                android:background="#a0a0a0"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#a0a0a0"
                android:id="@+id/sdm_myoffer_permission_manage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sdm_myoffer_panel_permission"
                style="@style/sdm_myoffer_banner_privacy_text_style"/>
            <View
                android:id="@+id/sdm_myoffer_center_line2"
                android:background="#a0a0a0"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#a0a0a0"
                android:id="@+id/sdm_myoffer_function_manage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sdm_myoffer_panel_funtion"
                style="@style/sdm_myoffer_banner_privacy_text_style"/>
        </LinearLayout>
        <com.smartdigimkt.sdk.basead.ui.component.MarqueeTextView
            android:textSize="10dp"
            android:textColor="#a0a0a0"
            android:ellipsize="marquee"
            android:gravity="left"
            android:id="@+id/sdm_myoffer_publisher_name"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_toRightOf="@+id/sdm_myoffer_four_element_container_subinfo"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:marqueeRepeatLimit="marquee_forever"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/sdm_myoffer_ad_logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
            android:id="@+id/sdm_myoffer_ad_logo"
            android:visibility="gone"
            android:layout_width="@dimen/sdm_myoffer_normal_ad_logo_width"
            android:layout_height="@dimen/sdm_myoffer_normal_ad_logo_height"
            android:layout_marginRight="@dimen/sdm_myoffer_ad_choice_margin_right"/>
    </FrameLayout>
</LinearLayout>
