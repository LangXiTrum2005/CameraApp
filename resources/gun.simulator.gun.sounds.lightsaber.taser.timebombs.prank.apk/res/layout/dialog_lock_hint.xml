<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#4d000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/get_weapon"
        android:fontFamily="@font/gb"
        app:layout_constraintBottom_toBottomOf="@+id/space_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_top"/>
    <Space
        android:id="@+id/space_top"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.21"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lav_weapon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toBottomOf="@+id/space_top"
        app:lottie_autoPlay="true"
        app:lottie_fileName="dialog_show_weapon/data.json"
        app:lottie_imageAssetsFolder="dialog_show_weapon/images"/>
    <ImageView
        android:id="@+id/iv_weapon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/test_ak47"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/lav_weapon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lav_weapon"
        app:layout_constraintVertical_bias="0.4036"
        app:layout_constraintWidth_percent="0.6111"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_weapon"
        android:background="@drawable/bg_dialog_weapon_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="AK47"
        android:alpha="0"
        android:fontFamily="@font/gb"
        app:layout_constraintBottom_toBottomOf="@+id/lav_weapon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lav_weapon"
        app:layout_constraintVertical_bias="0.828"
        app:layout_constraintWidth_percent="0.4715"/>
    <Space
        android:id="@+id/bottom"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6865"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/you_will_get_weapon_after_the_video_ad_plays"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toBottomOf="@+id/tv_weapon"
        app:layout_goneMarginTop="24dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffd12e"
        android:gravity="center"
        android:id="@+id/tv_ad_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/your_ad_begins_in_s"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toBottomOf="@+id/tv_hint"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_exit"
        android:background="@drawable/bt_rate_bg_grey"
        android:paddingTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/no_thanks"
        android:fontFamily="@font/gb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_ad_time"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_exit"/>
</androidx.constraintlayout.widget.ConstraintLayout>
