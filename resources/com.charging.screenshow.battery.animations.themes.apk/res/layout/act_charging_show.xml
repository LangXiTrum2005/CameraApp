<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flContainer"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.charging.screenshow.battery.animations.themes.view.scalablevideoview.ScalableVideoView
        android:id="@+id/svv"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llChargingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivLighting"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_lightning"
            app:tint="@color/theme_main"/>
        <TextView
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/theme_main"
            android:gravity="center"
            android:id="@+id/tvBattery"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@string/Roboto_Medium"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ivSettings"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="38dp"
        android:src="@drawable/ic_settings"
        android:alpha="0.6"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/llTips"
        android:background="@drawable/drw_card_theme_black_16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="46dp"
        android:layout_marginHorizontal="24dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"
            android:text="@string/close_tips"
            android:lineSpacingExtra="4dp"
            android:alpha="0.6"
            android:fontFamily="@string/Roboto_Regular"
            android:layout_marginHorizontal="16dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvClose"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"
            android:minWidth="160dp"
            android:text="@string/close"
            android:textAllCaps="true"
            android:fontFamily="@string/Roboto_Regular"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="28dp"/>
    </LinearLayout>
</FrameLayout>
