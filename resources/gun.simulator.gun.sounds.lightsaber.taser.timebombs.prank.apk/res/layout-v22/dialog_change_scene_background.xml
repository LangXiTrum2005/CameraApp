<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBg"
    android:background="@drawable/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:background="@drawable/bg_choose_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8889">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_scene_choose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="33dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/iv_title"
        android:background="@drawable/bg_change_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="-15dp"
        android:layout_marginRight="38dp"
        android:text="@string/Change_Background"
        android:fontFamily="@font/gb"
        android:layout_marginHorizontal="38dp"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintHeight_percent="0.0469"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"/>
    <ImageView
        android:id="@+id/iv_close_dialog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-20dp"
        android:src="@drawable/icon_close_rate_dialog"
        android:scaleType="centerCrop"
        android:layout_marginStart="-20dp"
        app:layout_constraintHeight_percent="0.0625"
        app:layout_constraintStart_toEndOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"
        app:layout_constraintWidth_percent="0.09"/>
</androidx.constraintlayout.widget.ConstraintLayout>
