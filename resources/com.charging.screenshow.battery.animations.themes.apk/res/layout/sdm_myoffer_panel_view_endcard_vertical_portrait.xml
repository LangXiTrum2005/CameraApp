<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="38dp"
        android:layout_marginRight="38dp"
        android:layout_above="@+id/sdm_myoffer_panel_cta_layout"
        android:layout_alignParentTop="true">
        <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
            android:id="@+id/sdm_myoffer_iv_banner_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_tv_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
        <TextView
            android:textSize="@dimen/sdm_myoffer_half_screen_desc_size_portrait"
            android:textColor="#000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_tv_banner_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
    </LinearLayout>
    <com.smartdigimkt.sdk.basead.ui.component.CTAButtonLayout
        android:layout_gravity="center"
        android:id="@+id/sdm_myoffer_panel_cta_layout"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginLeft="38dp"
        android:layout_marginRight="38dp"
        android:layout_marginBottom="48dp"
        android:layout_alignParentBottom="true"
        style="@style/sdm_myoffer_single_line"/>
    <com.smartdigimkt.sdk.basead.ui.ShakeTextHintView
        android:id="@+id/sdm_myoffer_shake_hint_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginRight="38dp"
        android:layout_marginBottom="102dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="38dp"
        android:layout_marginRight="38dp"
        android:layout_marginBottom="28dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_invalid_button"/>
</RelativeLayout>
