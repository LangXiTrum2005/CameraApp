<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/sdm_reward_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sdm_videoview_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/sdm_vfpv_fl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.smartdigimkt.expressad.playercommon.PlayerView
            android:gravity="center"
            android:id="@+id/sdm_vfpv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.smartdigimkt.expressad.video.dynview.widget.AnythinkBaitClickView
        android:id="@+id/sdm_animation_click_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.smartdigimkt.expressad.widget.rewardpopview.ATAcquireRewardPopView
        android:id="@+id/sdm_reward_popview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/sdm_top_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_alignParentTop="true">
        <ImageView
            android:gravity="center"
            android:id="@+id/sdm_iv_link"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/sdm_reward_notice"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"/>
        <com.smartdigimkt.expressad.widget.FeedBackButton
            android:textSize="11sp"
            android:gravity="center"
            android:id="@+id/sdm_native_endcard_feed_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:text="@string/sdm_cm_feedback_btn_text"
            android:layout_toRightOf="@+id/sdm_iv_link"
            android:layout_alignTop="@+id/sdm_iv_link"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/sdm_tv_count"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/sdm_native_endcard_feed_btn"
            android:layout_marginStart="10dp"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/sdm_rl_playing_close"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/sdm_reward_close"
            android:layout_alignParentRight="true"
            android:contentDescription="closeButton"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sdm_reward_bottom_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.smartdigimkt.expressad.video.widget.SoundImageView
            android:id="@+id/sdm_sound_switch"
            android:background="@drawable/sdm_reward_end_close_shape_oval"
            android:padding="6dp"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/sdm_reward_sound_open"
            android:layout_marginStart="10dp"/>
        <com.smartdigimkt.expressad.video.dynview.widget.AnyThinkSegmentsProgressBar
            android:id="@+id/sdm_reward_segment_progressbar"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>
        <FrameLayout
            android:id="@+id/sdm_reward_cta_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"/>
    </LinearLayout>
</RelativeLayout>
