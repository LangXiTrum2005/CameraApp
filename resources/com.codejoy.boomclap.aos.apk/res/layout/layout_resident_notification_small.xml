<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="55dp">
    <RelativeLayout
        android:id="@+id/residentClapButton"
        android:background="@drawable/bg_notify_button1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/boom_ic_notify_clap_small"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fff0eeff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Clap"
            android:maxLines="1"
            android:layout_marginStart="7dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/residentPrivacyButton"
        android:background="@drawable/bg_notify_button2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="6dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/boom_ic_notify_touch_small"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fff0eeff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Touch"
            android:maxLines="1"
            android:layout_marginStart="7dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/residentAntiTheftButton"
        android:background="@drawable/bg_notify_button3"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/boom_ic_notify_pocket_small"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fff0eeff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pocket"
            android:maxLines="1"
            android:layout_marginStart="7dp"/>
    </RelativeLayout>
</LinearLayout>
