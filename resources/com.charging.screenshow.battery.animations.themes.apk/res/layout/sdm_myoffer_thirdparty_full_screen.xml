<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sdm_myoffer_rl_root"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.smartdigimkt.sdk.basead.ui.PanelView
        android:id="@+id/sdm_myoffer_banner_view_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_4_element"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true">
        <com.smartdigimkt.sdk.basead.ui.CountDownView
            android:id="@+id/sdm_myoffer_count_down_view_id"
            android:layout_width="@dimen/sdm_myoffer_half_screen_button_size"
            android:layout_height="@dimen/sdm_myoffer_half_screen_button_size"/>
        <com.smartdigimkt.sdk.basead.ui.CloseImageView
            android:id="@+id/sdm_myoffer_btn_close_id"
            android:background="@drawable/sdm_myoffer_base_close_icon"
            android:layout_width="@dimen/sdm_myoffer_half_screen_button_size"
            android:layout_height="@dimen/sdm_myoffer_half_screen_button_size"
            android:layout_marginLeft="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">
        <TextView
            android:textSize="11dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_ad_lable"
            android:background="@drawable/sdm_myoffer_splash_ad_label_bg"
            android:paddingLeft="5dp"
            android:paddingTop="2dp"
            android:paddingRight="5dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/sdm_basead_ad_text"/>
        <com.smartdigimkt.sdk.basead.ui.MuteImageView
            android:id="@+id/sdm_myoffer_btn_mute_id"
            android:background="@drawable/sdm_myoffer_video_mute_icon"
            android:layout_width="@dimen/sdm_myoffer_half_screen_button_size"
            android:layout_height="@dimen/sdm_myoffer_half_screen_button_size"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/sdm_myoffer_ad_lable"
            android:layout_alignTop="@+id/sdm_myoffer_ad_lable"/>
    </LinearLayout>
</RelativeLayout>
