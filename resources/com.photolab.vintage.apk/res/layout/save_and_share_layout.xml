<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_dim"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:background="@color/surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:background="@color/surface"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:minHeight="?attr/actionBarSize"
            app:navigationIconTint="@color/on_surface"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:titleTextColor="@color/on_surface"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout2"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardMaxElevation="4dp">
            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/piclist_icon_default"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:contentDescription="@string/preview_image_desc"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="19dp"
        app:layout_constraintBottom_toTopOf="@+id/bannerAd">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/on_surface_light"
            android:gravity="center"
            android:id="@+id/path"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/share_section_title"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/sharebtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardMaxElevation="4dp">
            <LinearLayout
                android:orientation="horizontal"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:id="@+id/btnFace"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/share_facebook"
                    android:layout_weight="1"
                    app:icon="@drawable/ico_share_fb"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="24dp"
                    app:iconTint="@null"
                    style="@style/Widget.Material3.Button.TextButton"/>
                <View
                    android:background="@color/outline_variant"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:id="@+id/btnInta"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/share_instagram"
                    android:layout_weight="1"
                    app:icon="@drawable/ico_share_ins"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="24dp"
                    app:iconTint="@null"
                    style="@style/Widget.Material3.Button.TextButton"/>
                <View
                    android:background="@color/outline_variant"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:id="@+id/btnMore"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/share_more"
                    android:layout_weight="1"
                    app:icon="@drawable/ico_share_more"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="24dp"
                    app:iconTint="@null"
                    style="@style/Widget.Material3.Button.TextButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/bannerAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
