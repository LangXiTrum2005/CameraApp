<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="66dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true">
        <com.thinkup.core.common.ui.component.RoundImageView
            android:id="@+id/thinkup_myoffer_iv_banner_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/thinkup_myoffer_tv_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/thinkup_myoffer_single_line.nofontpadding"/>
        <TextView
            android:textSize="@dimen/thinkup_myoffer_half_screen_desc_size_portrait"
            android:textColor="#000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/thinkup_myoffer_tv_banner_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            style="@style/thinkup_myoffer_single_line.nofontpadding"/>
    </LinearLayout>
    <com.thinkup.core.common.inner.ui.ScanningAnimButton
        android:layout_gravity="center"
        android:id="@+id/thinkup_myoffer_panel_cta_layout"
        android:background="@drawable/thinkup_myoffer_splash_bg_rectangle_btn_cta_asseblem"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="24dp"
        android:layout_alignParentBottom="true"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/thinkup_myoffer_include_4_element"/>
</RelativeLayout>
