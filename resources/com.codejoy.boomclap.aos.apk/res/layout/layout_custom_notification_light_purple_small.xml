<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_custom_notification_light_purple"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:paddingHorizontal="8dp">
    <ImageView
        android:id="@+id/ivNotifyIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:clipToOutline="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ff1f1f1f"
            android:ellipsize="end"
            android:id="@+id/tvNotifyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#ff1f1f1f"
            android:ellipsize="end"
            android:id="@+id/tvNotifySubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:alpha="0.5"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tvNotifyButton"
        android:background="@drawable/bg_custom_notification_light_purple_button"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:text="@string/open"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="20dp"/>
</LinearLayout>
