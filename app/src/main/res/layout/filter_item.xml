<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wrap"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardBackgroundColor="@color/surface_container"
    app:cardElevation="2dp"
    app:cardMaxElevation="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:padding="4dp"
            android:layout_width="72dp"
            android:layout_height="72dp">
            <ImageView
                android:id="@+id/filterView"
                android:background="@drawable/bg_filter_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <ImageView
                android:id="@+id/check"
                android:background="@drawable/bg_check_circle"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/lock"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:src="@android:drawable/ic_lock_lock"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="4dp"
                android:layout_alignParentEnd="true"
                app:tint="#ffc107"/>
        </RelativeLayout>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:id="@+id/name"
            android:background="@drawable/bg_filter_label"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="Normal"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
