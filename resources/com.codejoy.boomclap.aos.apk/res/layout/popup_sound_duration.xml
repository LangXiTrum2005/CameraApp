<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_volume_bar"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp">
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="15dp"
        android:textColor="#df95ff"
        android:gravity="center_vertical"
        android:id="@+id/duration5s"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="5s"
        android:includeFontPadding="false"
        android:textDirection="locale"
        android:paddingStart="11dp"
        app:customFontWeight="medium"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="15dp"
        android:textColor="#df95ff"
        android:gravity="center_vertical"
        android:id="@+id/duration15s"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="15s"
        android:includeFontPadding="false"
        android:textDirection="locale"
        android:paddingStart="11dp"
        app:customFontWeight="medium"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="15dp"
        android:textColor="#df95ff"
        android:gravity="center_vertical"
        android:id="@+id/duration30s"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="30s"
        android:includeFontPadding="false"
        android:textDirection="locale"
        android:paddingStart="11dp"
        app:customFontWeight="medium"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="15dp"
        android:textColor="#df95ff"
        android:gravity="center_vertical"
        android:id="@+id/duration60s"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="60s"
        android:includeFontPadding="false"
        android:textDirection="locale"
        android:paddingStart="11dp"
        app:customFontWeight="medium"/>
</LinearLayout>
