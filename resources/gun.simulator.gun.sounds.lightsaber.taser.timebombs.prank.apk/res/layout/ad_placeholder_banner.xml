<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_native_banner_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.basic.lib.basic.view.RadiusImageView
            android:id="@+id/iv_ad_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/iv_prank_title"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="h,1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.1222"
            app:radius="2dp"/>
        <ImageView
            android:id="@+id/iv_ad_label"
            android:layout_width="25dp"
            android:layout_height="0dp"
            android:src="@drawable/ad_native_label"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_native_ad_content"
            app:layout_constraintDimensionRatio="h,25:12"
            app:layout_constraintStart_toEndOf="@+id/iv_ad_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#fff"
            android:id="@+id/tv_native_ad_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/PrankGuys"
            android:fontFamily="@font/rb"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="104dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_ad_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_ad_label"
            app:layout_constraintTop_toTopOf="@+id/iv_ad_label"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/bt_download"
            android:background="@drawable/bg_bt_ad_download"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Download"
            android:fontFamily="@font/rb"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_ad_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_native_ad_title"
            app:layout_constraintTop_toTopOf="@+id/iv_ad_title"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/tv_native_ad_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/Funny_all_in"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_native_ad_title"
            app:layout_constraintStart_toStartOf="@+id/iv_ad_label"
            app:layout_constraintTop_toBottomOf="@+id/iv_ad_label"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
