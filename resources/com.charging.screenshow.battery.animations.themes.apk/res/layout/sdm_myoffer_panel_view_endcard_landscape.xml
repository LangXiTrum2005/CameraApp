<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/sdm_myoffer_ll_top_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginRight="36dp"
        android:layout_marginBottom="130dp"
        android:layout_alignParentBottom="true">
        <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
            android:id="@+id/sdm_myoffer_iv_banner_icon"
            android:background="@drawable/sdm_myoffer_bg_circle_white"
            android:padding="20dp"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:cropToPadding="true"
            android:backgroundTint="#f5f5f5"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_tv_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
        <TextView
            android:textSize="@dimen/sdm_myoffer_half_screen_desc_size_portrait"
            android:textColor="#000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_tv_banner_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            style="@style/sdm_myoffer_single_line.nofontpadding"/>
    </LinearLayout>
    <com.smartdigimkt.sdk.basead.ui.component.CTAButtonLayout
        android:layout_gravity="center"
        android:id="@+id/sdm_myoffer_panel_cta_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"
        android:layout_marginBottom="30dp"
        android:layout_alignParentBottom="true"
        style="@style/sdm_myoffer_single_line"/>
    <com.smartdigimkt.sdk.basead.ui.ShakeTextHintView
        android:id="@+id/sdm_myoffer_shake_hint_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"
        android:layout_marginBottom="84dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"
        android:layout_marginBottom="30dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_invalid_button"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginRight="42dp"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_4_element"/>
</RelativeLayout>
