<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/theme_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/immersionBarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="4dp">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:id="@+id/cvContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="70dp"
                android:layout_marginRight="36dp"
                android:layout_marginBottom="50dp"
                android:layout_above="@+id/rlBottom"
                android:layout_centerHorizontal="true"
                android:layout_marginHorizontal="36dp"
                app:cardBackgroundColor="@color/dark_blue"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/theme_main"
                android:gravity="center"
                android:id="@+id/tvTip"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:minWidth="200dp"
                android:text="@string/click_again_to_stop"
                android:layout_above="@+id/rlBottom"
                android:layout_centerInParent="true"
                android:fontFamily="@string/Roboto_Regular"
                android:layout_marginVertical="20dp"
                android:paddingHorizontal="28dp"/>
            <RelativeLayout
                android:id="@+id/rlBottom"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_alignParentBottom="true">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tvApply"
                    android:background="@drawable/drw_card_theme_main_32dp"
                    android:paddingLeft="28dp"
                    android:paddingRight="28dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="200dp"
                    android:text="@string/apply"
                    android:layout_centerInParent="true"
                    android:fontFamily="@string/Roboto_Regular"
                    android:paddingHorizontal="28dp"/>
                <ImageView
                    android:id="@+id/ivSettings"
                    android:padding="6dp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_settings"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:layout_toStartOf="@+id/tvApply"/>
                <ImageView
                    android:id="@+id/ivEye"
                    android:padding="6dp"
                    android:visibility="visible"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_eye"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="18dp"
                    android:layout_toEndOf="@+id/tvApply"/>
            </RelativeLayout>
        </RelativeLayout>
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/ivBack"
            android:padding="8dp"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/ic_back_white"
            android:layout_marginStart="10dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llChargingPermission"
            android:background="@color/theme_black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/ivBack2"
                android:padding="8dp"
                android:visibility="visible"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_back_white"
                android:layout_marginStart="10dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="56dp"
                android:paddingHorizontal="32dp">
                <TextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_two_permission"
                    android:fontFamily="@string/Roboto_Medium"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="276dp"
                        android:layout_height="243dp"
                        android:src="@drawable/ic_permission_guide"/>
                </FrameLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llFloating"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:gravity="start"
                        android:visibility="visible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/floating_window_permission"
                        android:layout_weight="1"
                        android:fontFamily="@string/Roboto_Medium"/>
                    <Switch
                        android:id="@+id/switchAlert"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:thumbTint="@color/theme_gray"
                        android:trackTint="@color/theme_main"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llIgnoreBattery"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="80dp"
                    android:paddingVertical="4dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:gravity="start"
                        android:visibility="visible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ignore_battery_permission"
                        android:layout_weight="1"
                        android:fontFamily="@string/Roboto_Medium"/>
                    <Switch
                        android:id="@+id/switchBattery"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:thumbTint="@color/theme_gray"
                        android:trackTint="@color/theme_main"/>
                </LinearLayout>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tvNext"
                    android:background="@drawable/drw_card_theme_yellow_12dp"
                    android:paddingLeft="28dp"
                    android:paddingRight="28dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/next"
                    android:textAllCaps="true"
                    android:fontFamily="@string/Roboto_Regular"
                    android:paddingHorizontal="28dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
