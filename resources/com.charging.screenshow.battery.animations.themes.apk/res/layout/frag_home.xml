<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="@string/app_name"
            android:layout_centerVertical="true"
            android:textAllCaps="true"
            android:fontFamily="@font/fredoka_one_regular"
            android:layout_marginStart="16dp"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@color/bg_item_battery"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/bg_item_stroke"
                app:strokeWidth="1dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/imvBatteryAnim"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:src="@drawable/drw_ring"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="30sp"
                        android:textColor="@color/theme_main"
                        android:gravity="center"
                        android:id="@+id/tvBatteryPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/baloothambi2_semibold"
                        android:elevation="2dp"
                        app:layout_constraintBottom_toBottomOf="@+id/imvBatteryAnim"
                        app:layout_constraintEnd_toEndOf="@+id/imvBatteryAnim"
                        app:layout_constraintStart_toStartOf="@+id/imvBatteryAnim"
                        app:layout_constraintTop_toTopOf="@+id/imvBatteryAnim"/>
                    <ImageView
                        android:gravity="center"
                        android:background="@mipmap/ic_bolt_blue"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:elevation="2dp"
                        app:layout_constraintEnd_toEndOf="@+id/tvBatteryPercent"
                        app:layout_constraintStart_toStartOf="@+id/tvBatteryPercent"
                        app:layout_constraintTop_toBottomOf="@+id/tvBatteryPercent"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:elevation="2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/imvBatteryAnim"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_content_item"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/battery_power"
                            android:fontFamily="@font/be_vietnam_pro"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">
                            <View
                                android:background="@mipmap/bg_dot_blue"
                                android:layout_width="8dp"
                                android:layout_height="8dp"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/text_blue_start"
                                android:id="@+id/tvChargingStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/charging"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:layout_marginStart="4dp"/>
                            <View
                                android:background="@mipmap/bg_dot_violet"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginStart="8dp"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/text_blue_end"
                                android:id="@+id/tvTimeToFull"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/remaining_time_full_charge"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/btnBatterySpecs"
                            android:background="@drawable/bg_btn_battery_specs"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginTop="10dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@mipmap/ic_battery_specs"
                                android:contentDescription="@null"
                                app:tint="#715dfc"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/bg_main"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/battery_specs_tittle"
                                android:layout_weight="1"
                                android:textAllCaps="false"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:layout_marginStart="4dp"/>
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_arrow_right"
                                android:contentDescription="@null"
                                android:layout_marginStart="4dp"
                                app:tint="#715dfc"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/llEmpty"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_empty"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_default"
                        android:gravity="center"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:text="@string/empty_data_txt"
                        android:alpha="0.6"
                        android:fontFamily="@string/Roboto_Medium"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tvReload"
                        android:background="@drawable/drw_card_theme_main_32dp"
                        android:paddingLeft="28dp"
                        android:paddingRight="28dp"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/click_to_reload"
                        android:fontFamily="@string/Roboto_Regular"
                        android:paddingHorizontal="28dp"/>
                </LinearLayout>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/pbb"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="25dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="25dp"
                    android:indeterminateTint="@color/theme_main"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="25dp"/>
            </FrameLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
