<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.smartdigimkt.sdk.basead.ui.WaveAnimImageView
        android:id="@+id/sdm_myoffer_wave_anim_image"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_centerInParent="true"/>
    <com.smartdigimkt.sdk.basead.ui.WaveAnimImageView
        android:id="@+id/sdm_myoffer_wave_anim_image2"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/sdm_myoffer_guide_to_click_finger"
        android:layout_width="42dp"
        android:layout_height="46dp"
        android:layout_marginLeft="42dp"
        android:layout_marginTop="46dp"
        android:src="@drawable/sdm_myoffer_finger_white_v1"
        android:scaleType="fitCenter"
        android:layout_alignLeft="@+id/sdm_myoffer_wave_anim_image"
        android:layout_alignTop="@+id/sdm_myoffer_wave_anim_image"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#ffffff"
        android:id="@+id/sdm_myoffer_guide_to_click_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/sdm_myoffer_tap_for_detail2"
        android:layout_below="@+id/sdm_myoffer_guide_to_click_finger"
        android:layout_centerHorizontal="true"/>
</merge>
