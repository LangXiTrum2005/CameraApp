<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wrap"
    android:layout_width="76dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/bg_filter_item"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="68dp">
        <ImageView
            android:id="@+id/filterView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_camera_filter_thumbnail"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />
        <ImageView
            android:id="@+id/check"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_camera_check_circle"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/lock"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="end|top"
            android:layout_margin="4dp"
            android:background="@drawable/bg_premium_lock"
            android:padding="4dp"
            android:src="@android:drawable/ic_lock_lock"
            android:visibility="gone"
            app:tint="@color/camera_premium" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:text="Normal"
        android:textColor="@color/camera_text"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
