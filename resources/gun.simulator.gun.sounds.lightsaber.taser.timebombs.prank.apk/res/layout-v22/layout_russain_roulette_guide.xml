<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_guide1"
        android:background="@drawable/bg_russain_roulette_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.1518"
        app:layout_constraintWidth_percent="0.5333">
        <TextView
            android:textSize="13sp"
            android:textColor="#171717"
            android:id="@+id/tv1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/By_Default"
            android:fontFamily="@font/rr"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#f92020"
            android:id="@+id/tv_optional"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/Optional"
            android:fontFamily="@font/rr"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#171717"
        android:id="@+id/con_guide2"
        android:background="@drawable/bg_russain_roulette_tips"
        android:padding="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="@string/Swipe_the_trigger_to_shoot"
        android:fontFamily="@font/rr"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.422"
        app:layout_constraintWidth_percent="0.4889"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_guide3"
        android:background="@drawable/bg_russain_roulette_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="107dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.702"
        app:layout_constraintWidth_percent="0.4889">
        <TextView
            android:textSize="13sp"
            android:textColor="#171717"
            android:id="@+id/tv3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/Swipe_to_pull_the_hammer_back_or_forward"
            android:fontFamily="@font/rr"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#f92020"
            android:id="@+id/tv_not_necessary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/Optional"
            android:fontFamily="@font/rr"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/bt_got_it"
        android:background="@drawable/bt_rate_bg_light"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="16dp"
        android:text="@string/OK_got_it"
        android:fontFamily="@font/gb"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintBottom_toTopOf="@+id/con_weapon_banner"
        app:layout_constraintDimensionRatio="h,280:54"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.ArrowView
        android:id="@+id/arrow1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.ArrowView
        android:id="@+id/arrow2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.ArrowView
        android:id="@+id/arrow3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="arrow1, arrow2, arrow3,bt_got_it,con_guide1,con_guide2,con_guide3,tv1,tv_optional,tv3,tv_not_necessary"/>
</merge>
