<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_surface"
    android:fitsSystemWindows="false"
    android:paddingTop="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <org.wysaid.view.CameraRecordGLSurfaceView
            android:id="@+id/myGLSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View android:id="@+id/line1" android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/camera_grid"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.33" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <View android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/camera_grid"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.33" />
        <View android:id="@+id/line3" android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/camera_grid"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.66" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <View android:id="@+id/line4" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/camera_grid"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.66" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/focus" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_focus_camera"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

        <com.photolab.vintage.view.VerticalSlider
            android:id="@+id/intensive" android:layout_width="wrap_content" android:layout_height="184dp" android:layout_marginEnd="20dp" android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
            app:vs_thumb_color="@color/camera_accent" app:vs_thumb_radius="9dp" app:vs_track_bg_color="@color/camera_control_outline" app:vs_track_bg_thickness="2dp" app:vs_track_fg_color="@color/camera_accent" app:vs_track_fg_thickness="3dp" />

        <TextView
            android:id="@+id/countDown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="1" android:textColor="@color/camera_text" android:textSize="80sp" android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/topFunction" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="16dp" android:layout_marginTop="32dp" android:layout_marginEnd="16dp" android:background="@android:color/transparent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="2dp" android:paddingEnd="2dp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <FrameLayout android:id="@+id/btnMore" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_camera_toolbar">
            <androidx.appcompat.widget.AppCompatImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:padding="12dp" android:src="@drawable/ic_more" app:tint="@color/camera_icon" />
        </FrameLayout>
        <FrameLayout android:id="@+id/settings" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_camera_toolbar">
            <androidx.appcompat.widget.AppCompatImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:padding="12dp" android:src="@drawable/ic_info" app:tint="@color/camera_icon" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/moreOptionsMenu"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_camera_filter_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topFunction">

        <FrameLayout android:id="@+id/flash" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_camera_toolbar">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/flashIcon" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:padding="12dp" android:src="@drawable/ic_flash_off" app:tint="@color/camera_icon" />
        </FrameLayout>

        <FrameLayout android:id="@+id/grid" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_camera_toolbar">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/gridIcon" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:padding="12dp" android:src="@drawable/ic_grid_off" app:tint="@color/camera_icon" />
        </FrameLayout>

        <FrameLayout android:id="@+id/timer" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_camera_toolbar">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/clock" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:padding="12dp" android:src="@drawable/ic_clock" app:tint="@color/camera_icon" />
        </FrameLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/filterHeader" android:layout_width="0dp" android:layout_height="34dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_camera_filter_surface" android:paddingStart="18dp" android:paddingEnd="18dp"
        app:layout_constraintBottom_toTopOf="@+id/rvFilter" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">
        <TextView android:id="@+id/tvCategoryTitle" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentStart="true" android:gravity="center_vertical" android:text="BỘ LỌC" android:textColor="@color/camera_text" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvCategoryCount" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" android:gravity="center_vertical" android:text="50 hiệu ứng" android:textColor="@color/camera_text_muted" android:textSize="12sp" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFilter" android:layout_width="match_parent" android:layout_height="98dp" android:background="@android:color/transparent" android:clipToPadding="false" android:paddingStart="12dp" android:paddingEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/wrapFunction" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wrapFunction" android:layout_width="0dp" android:layout_height="188dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_camera_bottom_surface" android:paddingTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/fl_adplaceholder" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMode"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="10dp" />
        <LinearLayout
            android:id="@+id/zoomContainer"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_camera_filter_surface"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toTopOf="@id/takePhoto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvZoom1x"
                android:layout_width="34dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="1x"
                android:textColor="@color/camera_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvZoom3x"
                android:layout_width="34dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="3x"
                android:textColor="@color/camera_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvZoom10x"
                android:layout_width="34dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="10x"
                android:textColor="@color/camera_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/takePhoto" android:layout_width="84dp" android:layout_height="84dp" android:layout_marginBottom="6dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_capture_2"
            app:layout_constraintBottom_toTopOf="@id/rvMode" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/zoomContainer" />
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/gallery" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_gallery" android:tint="@color/camera_icon" app:civ_border_color="@color/camera_control_outline" app:civ_border_width="1dp" app:civ_circle_background_color="@color/camera_control"
            app:layout_constraintBottom_toBottomOf="@+id/takePhoto" app:layout_constraintEnd_toStartOf="@+id/takePhoto" app:layout_constraintHorizontal_bias="0.35" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@+id/takePhoto" />
        <FrameLayout
            android:id="@+id/swap" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginEnd="22dp"
            app:layout_constraintBottom_toBottomOf="@+id/takePhoto" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@+id/takePhoto">
            <de.hdodenhof.circleimageview.CircleImageView android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_swap_white" app:civ_border_color="@color/camera_control_outline" app:civ_border_width="1dp" app:civ_circle_background_color="@color/camera_control" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/fl_adplaceholder" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/camera_surface" android:gravity="bottom" android:orientation="vertical" android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
