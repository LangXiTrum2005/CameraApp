<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sdm_myoffer_media_ad_container"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/sdm_myoffer_rl"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/sdm_myoffer_template_margin_white"
        android:layout_marginRight="@dimen/sdm_myoffer_template_margin_white"
        android:layout_marginBottom="@dimen/sdm_myoffer_template_margin_bottom"
        android:layout_alignParentRight="true">
        <RelativeLayout
            android:id="@+id/sdm_myoffer_media_ad_cta_container"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true">
            <com.smartdigimkt.sdk.basead.ui.ScanningAnimButton
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/sdm_myoffer_media_ad_cta"
                android:background="@drawable/sdm_myoffer_splash_bg_rectangle_btn_cta_asseblem"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:minWidth="60dp"
                android:text="@string/sdm_myoffer_cta_learn_more"
                style="@style/sdm_myoffer_single_line"/>
        </RelativeLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/sdm_color_ff000000"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_banner_ad_desc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="12dp"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_above="@+id/sdm_myoffer_media_ad_cta_container"/>
        <RelativeLayout
            android:id="@+id/sdm_myoffer_rl_title"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginRight="6dp"
            android:layout_toLeftOf="@+id/sdm_myoffer_media_ad_cta_container"
            android:layout_alignTop="@+id/sdm_myoffer_media_ad_cta_container"
            android:layout_alignBottom="@+id/sdm_myoffer_media_ad_cta_container">
            <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
                android:id="@+id/sdm_myoffer_media_ad_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/sdm_color_ff000000"
                android:id="@+id/sdm_myoffer_banner_ad_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@+id/sdm_myoffer_media_ad_icon"
                android:layout_centerVertical="true"
                style="@style/sdm_myoffer_single_line.nofontpadding"/>
        </RelativeLayout>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/sdm_myoffer_template_margin_bottom"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_4_element_with_feedback"/>
    <RelativeLayout
        android:id="@+id/sdm_myoffer_media_ad_main_image_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/sdm_myoffer_template_margin_white"
        android:layout_marginTop="@dimen/sdm_myoffer_template_margin_white"
        android:layout_marginRight="@dimen/sdm_myoffer_template_margin_white"
        android:layout_marginBottom="@dimen/sdm_myoffer_template_margin_bottom"
        android:layout_toLeftOf="@+id/sdm_myoffer_rl"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/sdm_myoffer_media_ad_bg_blur"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/sdm_myoffer_media_ad_main_image"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <com.smartdigimkt.sdk.basead.ui.SimplePlayerNoG2CMediaView
            android:id="@+id/sdm_myoffer_media_ad_simple_player_view_no_g2c"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="6sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/sdm_myoffer_ad_lable"
        android:background="@drawable/sdm_myoffer_splash_ad_label_bg"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:text="@string/sdm_basead_ad_text"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <include layout="@layout/sdm_myoffer_include_guide2click_mask"/>
    <include layout="@layout/sdm_myoffer_include_guide2click_container"/>
</RelativeLayout>
