<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_console"
        app:layout_constraintEnd_toEndOf="@+id/iv_console"
        app:layout_constraintHorizontal_bias="0.0879"
        app:layout_constraintStart_toStartOf="@+id/iv_console"
        app:layout_constraintTop_toTopOf="@+id/iv_console"/>
    <Space
        android:id="@+id/guideline_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_console"
        app:layout_constraintEnd_toEndOf="@+id/iv_console"
        app:layout_constraintHorizontal_bias="0.9121"
        app:layout_constraintStart_toStartOf="@+id/iv_console"
        app:layout_constraintTop_toTopOf="@+id/iv_console"/>
    <Space
        android:id="@+id/console_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.9891"/>
    <ImageView
        android:id="@+id/iv_console"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/bg_time_bomb_console"
        app:layout_constraintBottom_toBottomOf="@+id/console_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/bg_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_time_bomb_time"
        app:layout_constraintEnd_toEndOf="@+id/iv_console"
        app:layout_constraintStart_toStartOf="@+id/iv_console"
        app:layout_constraintTop_toTopOf="@+id/iv_console"/>
    <TextView
        android:textSize="21sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:05:00"
        android:fontFamily="@font/rm"
        app:layout_constraintBottom_toBottomOf="@+id/bg_time"
        app:layout_constraintEnd_toEndOf="@+id/bg_time"
        app:layout_constraintStart_toStartOf="@+id/bg_time"
        app:layout_constraintTop_toTopOf="@+id/bg_time"/>
    <FrameLayout
        android:id="@+id/iv_minus_one_min"
        android:background="@drawable/bg_time_bomb_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_console"
        app:layout_constraintEnd_toStartOf="@+id/iv_add_one_min"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/guideline_left"
        app:layout_constraintTop_toTopOf="@+id/iv_console"
        app:layout_constraintVertical_bias="0.3869">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_time_bomb_minus_1_min"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/iv_add_one_min"
        android:background="@drawable/bg_time_bomb_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/iv_minus_one_second"
        app:layout_constraintStart_toEndOf="@+id/iv_minus_one_min"
        app:layout_constraintTop_toTopOf="@+id/iv_minus_one_min">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_time_bomb_add_1_min"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/iv_minus_one_second"
        android:background="@drawable/bg_time_bomb_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/iv_add_one_second"
        app:layout_constraintStart_toEndOf="@+id/iv_add_one_min"
        app:layout_constraintTop_toTopOf="@+id/iv_minus_one_min">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_time_bomb_minus_1_sec"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/iv_add_one_second"
        android:background="@drawable/bg_time_bomb_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/guideline_right"
        app:layout_constraintStart_toEndOf="@+id/iv_minus_one_second"
        app:layout_constraintTop_toTopOf="@+id/iv_minus_one_min">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_time_bomb_add_1_sec"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/iv_bg_refresh"
        android:background="@drawable/bg_time_bomb_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_console"
        app:layout_constraintStart_toStartOf="@+id/guideline_left"
        app:layout_constraintTop_toBottomOf="@+id/iv_minus_one_min">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_time_bomb_refresh"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/iv_bg_pause"
        android:background="@drawable/bg_time_bomb_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg_refresh"
        app:layout_constraintStart_toStartOf="@+id/iv_add_one_min"
        app:layout_constraintTop_toTopOf="@+id/iv_bg_refresh">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_time_bomb_pause"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_bg_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_time_bomb_start"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg_refresh"
        app:layout_constraintEnd_toEndOf="@+id/iv_add_one_second"
        app:layout_constraintTop_toTopOf="@+id/iv_bg_refresh"/>
    <ImageView
        android:id="@+id/iv_bullets"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="5dp"
        android:src="@drawable/icon_cartridge_bomb"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toTopOf="@+id/iv_console"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_bullets_number_in_cartridge_clip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="80"
        android:fontFamily="@font/rm"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_separator_bullets_number"
        app:layout_constraintEnd_toStartOf="@+id/tv_separator_bullets_number"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/iv_bullets"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_separator_bullets_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/"
        android:fontFamily="@font/rm"
        app:layout_constraintEnd_toStartOf="@+id/tv_bullets_number_all"
        app:layout_constraintStart_toEndOf="@+id/tv_bullets_number_in_cartridge_clip"
        app:layout_constraintTop_toBottomOf="@+id/iv_bullets"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_bullets_number_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:fontFamily="@font/rm"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_separator_bullets_number"
        app:layout_constraintEnd_toEndOf="@+id/iv_bullets"
        app:layout_constraintStart_toEndOf="@+id/tv_separator_bullets_number"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_unlimited"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="∞"
        android:fontFamily="@font/rm"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_bullets_number_in_cartridge_clip"
        app:layout_constraintEnd_toEndOf="@+id/iv_bullets"
        app:layout_constraintStart_toStartOf="@+id/iv_bullets"/>
</androidx.constraintlayout.widget.ConstraintLayout>
