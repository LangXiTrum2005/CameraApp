<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBg"
    android:background="@drawable/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:background="@drawable/bg_choose_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,320:192"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8889">
        <ImageView
            android:id="@+id/iv_shake_sensitivity"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:src="@drawable/iv_shake"
            app:layout_constraintDimensionRatio="h,140:80"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4375"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="11dp"
            android:text="@string/Shake_to_Fire_Sensitivity"
            android:fontFamily="@font/gr"
            android:layout_marginHorizontal="11dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_shake_sensitivity"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/con_seekbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="11dp"
            android:layout_marginBottom="18.5dp"
            android:layout_marginHorizontal="11dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.2083"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_app_name">
            <ImageView
                android:id="@+id/iv_shake"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/selector_shake_sensitivity"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_shake_sensitivity_seekbar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.LinerCustomSeekBar
                android:id="@+id/iv_shake_sensitivity_seekbar"
                android:layout_width="0dp"
                android:layout_height="16dp"
                app:backgroundDrawable="@drawable/bg_sensitivity_seekbar"
                app:foregroundDrawable="@drawable/fg_sensitivity_seekbar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="w,220:16.33"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:maxProgress="100"
                app:thumbDrawable="@drawable/thumb_sensitivity_seekbar"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/tv_max_sensitivity"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="11dp"
                android:text="100"
                android:fontFamily="@font/gr"
                android:layout_marginStart="12dp"
                android:layout_marginVertical="11dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_shake_sensitivity_seekbar"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_close_dialog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-20dp"
        android:src="@drawable/icon_close_rate_dialog"
        android:scaleType="centerCrop"
        android:layout_marginStart="-20dp"
        app:layout_constraintHeight_percent="0.0625"
        app:layout_constraintStart_toEndOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"
        app:layout_constraintWidth_percent="0.09"/>
</androidx.constraintlayout.widget.ConstraintLayout>
