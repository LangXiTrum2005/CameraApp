<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/topImage"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:src="@drawable/boomclap_bg_page_top_3"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="20dp"
        android:textColor="@color/white"
        android:id="@+id/tvActivate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/activate"
        app:customFontWeight="semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.codejoy.boom.clap.widget.BoomNestedScrollView
        android:fadingEdge="vertical"
        android:fadingEdgeLength="5dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topImage">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="0dp"
                android:layout_height="197dp"
                android:src="@drawable/boomclap_bg_activate"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/ivLogo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivLogo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="13dp"
                app:layout_constraintDimensionRatio="220:180"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.6"/>
            <FrameLayout
                android:id="@+id/titleLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="25dp"
                android:layout_marginHorizontal="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivLogo">
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="24dp"
                    android:textColor="#fff0eeff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/function_activate_title"
                    android:includeFontPadding="false"
                    app:customFontWeight="semibold"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/countdownLayout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.codejoy.boom.clap.widget.ParkinsansFontText
                        android:textSize="45dp"
                        android:textColor="#fff0eeff"
                        android:gravity="center"
                        android:id="@+id/tvCountDownSec"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:customFontWeight="semibold"/>
                    <com.codejoy.boom.clap.widget.ParkinsansFontText
                        android:textSize="30dp"
                        android:textColor="#fff0eeff"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="s"
                        android:layout_marginStart="5dp"
                        app:customFontWeight="semibold"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/tipLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="60dp"
                android:layout_marginRight="30dp"
                android:layout_marginHorizontal="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivLogo">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="start|center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/pocketOrTouchTip"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginVertical="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <View
                            android:background="@drawable/shape_oval"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:backgroundTint="#ff9d96bb"/>
                        <com.codejoy.boom.clap.widget.ParkinsansFontText
                            android:textSize="18dp"
                            android:textColor="#ff9d96bb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/activate_tips1"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="12dp"
                            app:customFontWeight="regular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginVertical="5dp"
                        app:layout_constraintStart_toStartOf="@+id/ll1"
                        app:layout_constraintTop_toBottomOf="@+id/ll1">
                        <View
                            android:background="@drawable/shape_oval"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:backgroundTint="#ff9d96bb"/>
                        <com.codejoy.boom.clap.widget.ParkinsansFontText
                            android:textSize="18dp"
                            android:textColor="#ff9d96bb"
                            android:id="@+id/tvActivateTips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/activate_tips2"
                            android:layout_marginStart="12dp"
                            app:customFontWeight="regular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginVertical="5dp"
                        app:layout_constraintStart_toStartOf="@+id/ll2"
                        app:layout_constraintTop_toBottomOf="@+id/ll2">
                        <View
                            android:background="@drawable/shape_oval"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:backgroundTint="#ff9d96bb"/>
                        <com.codejoy.boom.clap.widget.ParkinsansFontText
                            android:textSize="18dp"
                            android:textColor="#ff9d96bb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/activate_tips3"
                            android:includeFontPadding="false"
                            android:layout_marginStart="12dp"
                            app:customFontWeight="regular"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="20dp"
                    android:textColor="#ff9d96bb"
                    android:gravity="center"
                    android:id="@+id/tvTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/function_activate_tip"
                    android:includeFontPadding="false"
                    app:customFontWeight="regular"/>
            </FrameLayout>
            <com.codejoy.boom.clap.widget.ParkinsansFontText
                android:textSize="20dp"
                android:textColor="#fff0eeff"
                android:id="@+id/stopOrOkButton"
                android:paddingLeft="50dp"
                android:paddingTop="14dp"
                android:paddingRight="50dp"
                android:paddingBottom="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="30dp"
                android:text="@string/stop"
                android:paddingHorizontal="50dp"
                android:paddingVertical="14dp"
                app:customFontWeight="semibold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tipLayout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.codejoy.boom.clap.widget.BoomNestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
