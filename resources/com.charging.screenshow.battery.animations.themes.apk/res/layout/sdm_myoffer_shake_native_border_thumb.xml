<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@+id/sdm_myoffer_splash_shake_border_img"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/sdm_myoffer_shake_icon"
        android:tint="#ffffff"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/sdm_myoffer_splash_shake_hint_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:maxWidth="94dp"
        android:text="@string/sdm_myoffer_shake_full_title"
        android:maxLines="2"/>
</merge>
