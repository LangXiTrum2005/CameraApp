<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBg"
    android:background="#cc000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_rate_us"
        android:background="@drawable/bg_rate_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_dialog_rate_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="17dp"
            android:layout_marginRight="20dp"
            android:text="@string/Thanks_for_using"
            android:fontFamily="@font/mb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center_horizontal"
            android:id="@+id/tv_dialog_rate_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/Thanks_your_feedback"
            android:fontFamily="@font/rr"
            app:layout_constraintEnd_toEndOf="@+id/tv_dialog_rate_title"
            app:layout_constraintStart_toStartOf="@+id/tv_dialog_rate_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_dialog_rate_title"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lavFiveStar"
            android:layout_width="74dp"
            android:layout_height="70dp"
            app:layout_constraintBottom_toBottomOf="@+id/rating_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.9476"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rating_bar"
            app:lottie_autoPlay="false"
            app:lottie_fileName="ani_five_stars/data.json"
            app:lottie_imageAssetsFolder="ani_five_stars/images"
            app:lottie_loop="true"/>
        <per.wsj.library.AndRatingBar
            android:id="@+id/rating_bar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="25dp"
            android:layout_marginRight="20dp"
            android:numStars="5"
            android:rating="0"
            android:stepSize="1"
            android:alpha="1"
            app:bgDrawable="@drawable/star_false"
            app:keepOriginColor="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dialog_rate_content"
            app:starDrawable="@drawable/star_true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lavRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/rating_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rating_bar"
            app:lottie_autoPlay="false"
            app:lottie_fileName="ani_light_up_stars/data.json"
            app:lottie_imageAssetsFolder="ani_light_up_stars/images"
            app:lottie_loop="false"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#3f258b"
            android:gravity="center"
            android:id="@+id/tvGuide"
            android:background="@drawable/bg_guide_rate"
            android:paddingLeft="6dp"
            android:paddingTop="8dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/The_best_we_can_get"
            android:fontFamily="@font/gr"
            android:layout_marginEnd="21dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rating_bar"/>
        <TextView
            android:enabled="false"
            android:textSize="18sp"
            android:textColor="@drawable/selecotr_rate_color"
            android:gravity="center"
            android:id="@+id/tv_rate"
            android:background="@drawable/selector_bg_btn_rate"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="24dp"
            android:text="@string/Rate"
            android:maxLines="2"
            android:fontFamily="@font/gb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGuide"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="210dp"
        android:layout_height="110dp"
        android:layout_marginBottom="-50dp"
        android:src="@drawable/pic_zero_star"
        app:layout_constraintBottom_toTopOf="@+id/cl_rate_us"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
