<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#252833"
    android:layout_width="match_parent"
    android:layout_height="120dp">
    <View
        android:id="@+id/ad_media_view"
        android:background="#313645"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="w,181:120"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_ad_label"
        android:layout_width="25dp"
        android:layout_height="0dp"
        android:src="@drawable/ad_native_label"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,25:12"
        app:layout_constraintStart_toEndOf="@+id/ad_media_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.127"/>
    <View
        android:background="#313645"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toTopOf="@+id/view2"
        app:layout_constraintDimensionRatio="w,60:15"
        app:layout_constraintHeight_percent="0.125"
        app:layout_constraintStart_toEndOf="@+id/iv_ad_label"/>
    <View
        android:id="@+id/view2"
        android:background="#313645"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintDimensionRatio="h,150:15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view3"
        app:layout_constraintTop_toBottomOf="@+id/iv_ad_label"/>
    <View
        android:id="@+id/view3"
        android:background="#313645"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="68dp"
        app:layout_constraintDimensionRatio="h,100:15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view4"
        app:layout_constraintTop_toBottomOf="@+id/view2"/>
    <View
        android:id="@+id/view4"
        android:background="#313645"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="11dp"
        android:layout_marginBottom="13dp"
        android:layout_marginHorizontal="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,157:33"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ad_media_view"
        app:layout_constraintTop_toBottomOf="@+id/view3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
