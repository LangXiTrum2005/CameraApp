<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/boomclap_img_guide_2"
        app:layout_constraintBottom_toTopOf="@+id/templateView"
        app:layout_constraintDimensionRatio="h,750:1092"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="180dp"/>
    <View
        android:background="@drawable/bg_guide_bottom_shadow"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="30dp"
        android:textColor="#f5f3ff"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="32dp"
        android:text="@string/guide_tip2"
        android:layout_marginHorizontal="13dp"
        app:customFontWeight="semibold"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.codejoy.boom.clap.ad.native_templates.TemplateView
        android:id="@+id/templateView"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:gnt_template_type="@layout/native_template3_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
