<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sdm_myoffer_banner_root"
    android:background="@drawable/sdm_myoffer_bg_banner"
    android:layout_width="320dp"
    android:layout_height="90dp">
    <include layout="@layout/sdm_myoffer_include_4_element_banner"/>
    <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
        android:id="@+id/sdm_myoffer_banner_icon"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"/>
    <com.smartdigimkt.sdk.basead.ui.ScanningAnimButton
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/sdm_myoffer_banner_ad_install_btn"
        android:background="@drawable/sdm_myoffer_splash_bg_rectangle_btn_cta_asseblem"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_toRightOf="@+id/sdm_myoffer_banner_icon"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        style="@style/sdm_myoffer_single_line"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sdm_ll_title_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp"
        android:layout_toRightOf="@+id/sdm_myoffer_banner_icon">
        <com.smartdigimkt.sdk.basead.ui.component.NoShadowMarqueeTextView
            android:textSize="14dp"
            android:textColor="#000000"
            android:ellipsize="marquee"
            android:gravity="left"
            android:id="@+id/sdm_myoffer_banner_ad_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"/>
        <com.smartdigimkt.sdk.basead.ui.component.NoShadowMarqueeTextView
            android:textSize="12dp"
            android:textColor="#000000"
            android:ellipsize="marquee"
            android:gravity="left"
            android:id="@+id/sdm_myoffer_banner_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"/>
    </LinearLayout>
    <include layout="@layout/sdm_myoffer_include_guide2click_mask"/>
    <include layout="@layout/sdm_myoffer_include_guide2click_container"/>
</RelativeLayout>
