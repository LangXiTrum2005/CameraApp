<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_loading_reward"
        android:background="@drawable/bg_dialog_reward_ads"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8889">
        <ImageView
            android:id="@+id/iv_not_network"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_marginTop="38dp"
            android:src="@drawable/icon_no_network"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/tv_not_internet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="32dp"
            android:text="@string/No_Internet"
            android:fontFamily="@font/gr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_not_network"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#c7ffffff"
            android:gravity="center"
            android:id="@+id/tv_fail_load_ads"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:text="@string/Please_check_your_internet_connection"
            android:fontFamily="@font/rr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_not_internet"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/bt_try_again"
            android:background="@drawable/bt_rate_bg_light"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="37dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="37dp"
            android:layout_marginBottom="35dp"
            android:text="@string/Try_again"
            android:fontFamily="@font/gb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="h,49:243"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_fail_load_ads"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
