<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/thinkup_myoffer_media_ad_container"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/thinkup_myoffer_media_ad_main_image_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="140dp">
        <ImageView
            android:id="@+id/thinkup_myoffer_media_ad_bg_blur"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/thinkup_myoffer_media_ad_main_image"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.thinkup.core.common.ui.component.RoundImageView
        android:id="@+id/thinkup_myoffer_media_ad_icon"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="82dp"
        android:scaleType="centerCrop"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"/>
    <RelativeLayout
        android:id="@+id/thinkup_myoffer_media_ad_cta_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="24dp"
        android:layout_alignParentBottom="true">
        <com.thinkup.core.common.inner.ui.ScanningAnimButton
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/thinkup_myoffer_media_ad_cta"
            android:background="@drawable/thinkup_myoffer_splash_bg_rectangle_btn_cta_asseblem"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minWidth="60dp"
            android:text="@string/thinkup_myoffer_cta_learn_more"
            style="@style/thinkup_myoffer_single_line"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="82dp"
        android:layout_toRightOf="@+id/thinkup_myoffer_media_ad_icon"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="18dp"
            android:textColor="@color/thinkup_color_ff000000"
            android:id="@+id/thinkup_myoffer_banner_ad_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/thinkup_myoffer_single_line.nofontpadding"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/thinkup_color_ff000000"
            android:id="@+id/thinkup_myoffer_banner_ad_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            style="@style/thinkup_myoffer_single_line.nofontpadding"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/thinkup_myoffer_include_4_element_with_feedback"/>
    <TextView
        android:textSize="6sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/thinkup_myoffer_ad_lable"
        android:background="@drawable/thinkup_myoffer_splash_ad_label_bg"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:text="@string/thinkup_basead_ad_text"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <include layout="@layout/thinkup_myoffer_include_guide2click_mask"/>
    <include layout="@layout/thinkup_myoffer_include_guide2click_container"/>
</RelativeLayout>
