<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/iv_bullets"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="26dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_separator_bullets_number"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_bullets_number_in_cartridge_clip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="80"
        android:fontFamily="@font/rm"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_separator_bullets_number"
        app:layout_constraintEnd_toStartOf="@+id/tv_separator_bullets_number"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/iv_bullets"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_separator_bullets_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:text="/"
        android:fontFamily="@font/rm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_bullets_number_all"
        app:layout_constraintStart_toEndOf="@+id/tv_bullets_number_in_cartridge_clip"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_bullets_number_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:fontFamily="@font/rm"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_separator_bullets_number"
        app:layout_constraintEnd_toEndOf="@+id/iv_bullets"
        app:layout_constraintStart_toEndOf="@+id/tv_separator_bullets_number"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffff"
        android:id="@+id/tv_unlimited"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="∞"
        android:fontFamily="@font/rm"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_bullets_number_in_cartridge_clip"
        app:layout_constraintEnd_toEndOf="@+id/kpb_bullets_number"
        app:layout_constraintStart_toStartOf="@+id/kpb_bullets_number"/>
    <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.KnobProgressBar
        android:id="@+id/kpb_bullets_number"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:android_min="0"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bullets"
        app:layout_constraintEnd_toEndOf="@+id/iv_bullets"
        app:layout_constraintStart_toStartOf="@+id/iv_bullets"
        app:layout_constraintTop_toTopOf="@+id/iv_bullets"
        app:progressBg="@drawable/bg_technology_gun_pb"
        app:progressFg="@drawable/fg_technology_gun_pb"
        app:progressSrc="@drawable/src_technology_gun_pb"
        app:scaleEnd="335"
        app:scaleStart="25"/>
</merge>
