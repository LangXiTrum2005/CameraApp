<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentRight="true">
    <com.thinkup.core.common.inner.ui.CloseFrameLayout
        android:id="@+id/thinkup_myoffer_splash_skip_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/thinkup_myoffer_splash_skip"
            android:background="@drawable/thinkup_myoffer_splash_bg_skip"
            android:paddingLeft="14dp"
            android:paddingRight="11dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="16dp"
            android:minWidth="68dp"
            android:minHeight="24dp"
            android:text="skip"
            android:includeFontPadding="false"/>
    </com.thinkup.core.common.inner.ui.CloseFrameLayout>
    <com.thinkup.core.common.inner.ui.CloseShadeView
        android:gravity="center"
        android:id="@+id/thinkup_myoffer_splash_skip_shade_area"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
