<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="6">

    <FrameLayout
        android:id="@+id/none"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/none_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/none_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_none"
                app:tint="@color/camera_icon" />
            <TextView
                android:id="@+id/none_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Xóa"
                android:textColor="@color/camera_text_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/filter"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/filter_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/filter_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_filter"
                app:tint="@color/camera_icon" />
            <TextView
                android:id="@+id/filter_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bộ lọc"
                android:textColor="@color/camera_text"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/dust"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/dust_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dust_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_dust"
                app:tint="@color/camera_icon" />
            <TextView
                android:id="@+id/dust_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bụi phim"
                android:textColor="@color/camera_text_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/light"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/light_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/light_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_light"
                app:tint="@color/camera_icon" />
            <TextView
                android:id="@+id/light_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ánh sáng"
                android:textColor="@color/camera_text_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/mask"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/mask_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mask_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_mask"
                app:tint="@color/camera_icon" />
            <TextView
                android:id="@+id/mask_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mặt nạ"
                android:textColor="@color/camera_text_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/gradient"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/gradient_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/gradient_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_gradient"
                app:tint="@color/camera_icon" />
            <TextView
                android:id="@+id/gradient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chuyển màu"
                android:textColor="@color/camera_text_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
