<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <gun.simulator.gun.sounds.lightsaber.taser.timebombs.prank.views.StatusBarFitView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <VideoView
        android:id="@+id/video_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/fl_spine"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/con_weapon_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/surface_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_boom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/con_weapon_banner"
        app:layout_constraintDimensionRatio="h,1080:1653"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextureView
        android:id="@+id/tv_video"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_gun_parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/con_weapon_banner"
        app:layout_constraintTop_toBottomOf="@+id/status_bar">
        <Space
            android:id="@+id/space_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/status_bar"/>
        <include layout="@layout/layout_weapon_activity_action"/>
        <ViewStub
            android:id="@+id/vb_time_bomb"
            android:layout="@layout/layout_time_bomb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_boom"
        app:layout_constraintTop_toTopOf="@+id/iv_boom">
        <ViewStub
            android:id="@+id/vb_time_bomb_n"
            android:layout="@layout/layout_time_bomb_n"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewStub
            android:id="@+id/vb_time_bomb_s"
            android:layout="@layout/layout_time_bomb_s"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewStub
            android:id="@+id/vb_time_bomb_c4"
            android:layout="@layout/layout_time_bomb_c4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:id="@+id/vb_bomb_effect"
        android:layout="@layout/layout_bomb_effect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lav_reload_bullets_circle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.1562"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4259"
        app:layout_constraintWidth_percent="0.2778"
        app:lottie_autoPlay="false"
        app:lottie_fileName="reload_bullets_circle/data.json"
        app:lottie_imageAssetsFolder="reload_bullets_circle/images"/>
    <ImageView
        android:id="@+id/iv_reload_bullets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/icon_reload_bullets_machine"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/lav_reload_bullets_circle"
        app:layout_constraintEnd_toEndOf="@+id/lav_reload_bullets_circle"
        app:layout_constraintHeight_percent="0.0719"
        app:layout_constraintStart_toStartOf="@+id/lav_reload_bullets_circle"
        app:layout_constraintTop_toTopOf="@+id/lav_reload_bullets_circle"
        app:layout_constraintWidth_percent="0.1278"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_reload_tv"
        android:background="@drawable/bg_con_reload"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/lav_reload_bullets_circle"
        app:layout_constraintStart_toStartOf="@+id/lav_reload_bullets_circle"
        app:layout_constraintTop_toBottomOf="@+id/lav_reload_bullets_circle"
        app:layout_constraintWidth_percent="0.5352">
        <TextView
            android:textSize="15sp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/tv_reload_bullets"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/SWIPE_TO_RELOAD"
            android:maxLines="1"
            android:fontFamily="@font/gr"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lav_reload_bullets_hand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.3219"
        app:layout_constraintHorizontal_bias="0.8095"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4485"
        app:layout_constraintWidth_percent="0.2222"
        app:lottie_fileName="reload_bullets_slide_hand/data.json"
        app:lottie_imageAssetsFolder="reload_bullets_slide_hand/images"
        app:lottie_loop="true"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_reload_bullets"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="lav_reload_bullets_hand,con_reload_tv,iv_reload_bullets,lav_reload_bullets_circle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/con_weapon_banner"
        android:background="#252834"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/strokeViewTop"
            android:background="#808289"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
