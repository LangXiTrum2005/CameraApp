<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ff100b18"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/nestedScrollView"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="6dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toTopOf="@+id/nativeTemplateView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backButton">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="18dp"
                android:layout_marginHorizontal="18dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="30dp"
                    android:src="@drawable/boomclap_bg_settings_sound"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="339:146"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivTopSound"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/boomclap_bg_settings_menu"
                    app:layout_constraintDimensionRatio="339:51"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSound"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/boomclap_ic_settings_sound"
                    android:layout_marginStart="25dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivTopSound"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ivTopSound"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="18dp"
                    android:textColor="#ffe3deff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sound_sensitivity"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivTopSound"
                    app:layout_constraintStart_toEndOf="@+id/ivSound"
                    app:layout_constraintTop_toTopOf="@+id/ivTopSound"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/sensitivityLayout"
                    android:paddingLeft="30dp"
                    android:paddingTop="13dp"
                    android:paddingRight="30dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="13dp"
                    app:layout_constraintTop_toBottomOf="@+id/ivTopSound">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/veryHighButton"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">
                        <com.codejoy.boom.clap.widget.ParkinsansFontText
                            android:textSize="16dp"
                            android:textColor="#ffd7d1ff"
                            android:ellipsize="end"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/sensitivity_very_high"
                            android:maxLines="2"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:customFontWeight="medium"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/sensitivity_checkbox"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/highButton"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">
                        <com.codejoy.boom.clap.widget.ParkinsansFontText
                            android:textSize="16dp"
                            android:textColor="#ffd7d1ff"
                            android:ellipsize="end"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/sensitivity_high"
                            android:maxLines="2"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:customFontWeight="medium"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/sensitivity_checkbox"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/averageButton"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">
                        <com.codejoy.boom.clap.widget.ParkinsansFontText
                            android:textSize="16dp"
                            android:textColor="#ffd7d1ff"
                            android:ellipsize="end"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/sensitivity_average"
                            android:maxLines="2"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:customFontWeight="medium"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/sensitivity_checkbox"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="18dp"
                android:layout_marginHorizontal="18dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="30dp"
                    android:src="@drawable/boomclap_bg_settings_schedule"
                    app:layout_constraintDimensionRatio="339:124"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivTopSchedule"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/boomclap_bg_settings_menu"
                    app:layout_constraintDimensionRatio="339:51"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSchedule"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/boomclap_ic_settings_schedule"
                    android:layout_marginStart="25dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivTopSchedule"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ivTopSchedule"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="18dp"
                    android:textColor="#ffe3deff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivTopSchedule"
                    app:layout_constraintStart_toEndOf="@+id/ivSchedule"
                    app:layout_constraintTop_toTopOf="@+id/ivTopSchedule"/>
                <com.codejoy.boom.clap.widget.Switch
                    android:id="@+id/deactivateFeatureEnable"
                    android:layout_width="55dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivTopSchedule"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="38dp"
                    android:layout_marginRight="38dp"
                    android:layout_marginHorizontal="38dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivTopSchedule">
                    <com.codejoy.boom.clap.widget.ParkinsansFontText
                        android:textSize="16dp"
                        android:textColor="#ffd7d1ff"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="7dp"
                        android:text="@string/start"
                        android:includeFontPadding="false"
                        app:customFontWeight="medium"
                        app:layout_constraintBottom_toTopOf="@+id/flDeactivateStartTime"
                        app:layout_constraintEnd_toEndOf="@+id/flDeactivateStartTime"
                        app:layout_constraintStart_toStartOf="@+id/flDeactivateStartTime"/>
                    <com.codejoy.boom.clap.widget.ParkinsansFontText
                        android:textSize="16dp"
                        android:textColor="#ffd7d1ff"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="7dp"
                        android:text="@string/end"
                        android:includeFontPadding="false"
                        app:customFontWeight="medium"
                        app:layout_constraintBottom_toTopOf="@+id/flDeactivateEndTime"
                        app:layout_constraintEnd_toEndOf="@+id/flDeactivateEndTime"
                        app:layout_constraintStart_toStartOf="@+id/flDeactivateEndTime"/>
                    <FrameLayout
                        android:id="@+id/flDeactivateStartTime"
                        android:background="@drawable/bg_gradient_schedule"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginBottom="19dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/flDeactivateEndTime"
                        app:layout_constraintStart_toStartOf="parent">
                        <com.codejoy.boom.clap.widget.ParkinsansFontText
                            android:textSize="18dp"
                            android:textColor="#ffdf95ff"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tvDeactivateStartTime"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="00:00"
                            android:includeFontPadding="false"
                            app:customFontWeight="semibold"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/flDeactivateEndTime"
                        android:background="@drawable/bg_gradient_schedule"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        app:layout_constraintBottom_toBottomOf="@+id/flDeactivateStartTime"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/flDeactivateStartTime">
                        <com.codejoy.boom.clap.widget.ParkinsansFontText
                            android:textSize="18dp"
                            android:textColor="#ffdf95ff"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tvDeactivateEndTime"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="00:00"
                            android:includeFontPadding="false"
                            app:customFontWeight="semibold"/>
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/languageButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="18dp"
                android:layout_marginHorizontal="18dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/boomclap_bg_settings_menu"
                    app:layout_constraintDimensionRatio="339:51"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivLanguage"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/boomclap_ic_settings_language"
                    android:layout_marginStart="25dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="18dp"
                    android:textColor="#ffe3deff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/st_language"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivLanguage"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="16dp"
                    android:textColor="#ff9d96bb"
                    android:id="@+id/tvLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="28dp"
                    app:customFontWeight="regular"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="18dp"
                android:layout_marginHorizontal="18dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/boomclap_bg_settings_menu"
                    app:layout_constraintDimensionRatio="339:51"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivRate"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/boomclap_ic_settings_rate"
                    android:layout_marginStart="25dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="18dp"
                    android:textColor="#ffe3deff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/st_rate_me"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivRate"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/privacyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="18dp"
                android:layout_marginHorizontal="18dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/boomclap_bg_settings_menu"
                    app:layout_constraintDimensionRatio="339:51"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPrivacy"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/boomclap_ic_settings_privacy"
                    android:layout_marginStart="25dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="18dp"
                    android:textColor="#ffe3deff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/st_privacy_policy"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivPrivacy"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/versionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="18dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="18dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/boomclap_bg_settings_menu"
                    app:layout_constraintDimensionRatio="339:51"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivVersion"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/boomclap_ic_settings_version"
                    android:layout_marginStart="25dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="18dp"
                    android:textColor="#ffe3deff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/version"
                    android:layout_marginStart="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivVersion"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.codejoy.boom.clap.widget.ParkinsansFontText
                    android:textSize="16dp"
                    android:textColor="#ff9d96bb"
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="28dp"
                    app:customFontWeight="regular"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/boomclap_ic_back"/>
        <com.codejoy.boom.clap.widget.ParkinsansFontText
            android:textSize="14dp"
            android:textColor="#ff9d96bb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:src="@drawable/boomclap_bg_page_top_3"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.codejoy.boom.clap.widget.ParkinsansFontText
        android:textSize="20dp"
        android:textColor="@color/white"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/setting"
        app:customFontWeight="semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.codejoy.boom.clap.ad.native_templates.TemplateView
        android:id="@+id/nativeTemplateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:gnt_template_type="@layout/native_template3_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
