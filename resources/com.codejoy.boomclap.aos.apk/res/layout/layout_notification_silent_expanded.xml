<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/boomclap_bg_noti_expand"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="69dp"
            android:layout_height="67dp"
            android:src="@drawable/boomclap_ic_not_disable"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#ffe3deff"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/silent_mode_notify_title"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ccd7d1ff"
                android:id="@+id/tvContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/silent_mode_notify_content"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:background="@drawable/bg_gradient_button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="11dp">
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/boomclap_ic_btn"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#fff8ffea"
            android:id="@+id/tvBtnContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/silent_mode_notify_btn"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
