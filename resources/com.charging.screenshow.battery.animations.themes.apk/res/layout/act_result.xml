<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/theme_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/immersionBarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/flAnimation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:layout_centerHorizontal="true">
            <com.charging.screenshow.battery.animations.themes.view.CompleteView
                android:id="@+id/viewComplete"
                android:layout_width="160dp"
                android:layout_height="160dp"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottie"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:lottie_autoPlay="true"
                app:lottie_rawRes="@raw/charging"/>
        </FrameLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="56dp"
            android:layout_marginTop="120dp"
            android:layout_marginRight="56dp"
            android:text="@string/set_image_success_both"
            android:layout_below="@+id/flAnimation"
            android:layout_centerHorizontal="true"
            android:fontFamily="@string/Roboto_Medium"
            android:layout_marginHorizontal="56dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvContinue"
            android:background="@drawable/drw_card_theme_main_32dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:layout_marginBottom="12dp"
            android:minWidth="200dp"
            android:text="@string/txt_continue"
            android:layout_alignParentBottom="true"
            android:layout_centerInParent="true"
            android:fontFamily="@string/Roboto_Regular"
            android:layout_marginHorizontal="56dp"/>
    </RelativeLayout>
</LinearLayout>
